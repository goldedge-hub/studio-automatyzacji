---
// Premium shell (Paper & Signal) merged onto the r3 data/SEO contracts.
// CSS order matters: fonts -> legacy r3 layers -> premium layer (premium wins).
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/premium.css';
import '../styles/premium-shell.css';
import '../styles/seo-premium.css';
import '../styles/home-premium.css';

import frauncesNormal from '../fonts/fraunces-latN-500.woff2?url';
import frauncesExt from '../fonts/fraunces-extN-500.woff2?url';
import frauncesItalic from '../fonts/fraunces-latI-500.woff2?url';
import frauncesLight from '../fonts/fraunces-latN-300.woff2?url';
import interLatin from '../fonts/inter-lat-400.woff2?url';
import interExt from '../fonts/inter-ext-400.woff2?url';
import jbmLatin from '../fonts/jbm-lat-400.woff2?url';
import jbmExt from '../fonts/jbm-ext-400.woff2?url';

import {
  CONTACT_EMAIL,
  CONTACT_HREF,
  CONTACT_RESPONSE_PHRASE,
  PRICE_UPDATED,
  SITE_URL,
  UMAMI_HOST,
  UMAMI_SRC,
  UMAMI_WEBSITE_ID,
  withTrailingSlash,
} from '../config';
import { COMPANY, COMPANY_ADDRESS } from '../data/company';
import { P, PRICES } from '../data/pricing';
import { SEO_PAGES } from '../data/seo-pages';

const {
  title,
  description,
  path = '/',
  noindex = false,
  faq = null,
  hideCanonical = false,
} = Astro.props;

const site = SITE_URL;
const canonical = new URL(withTrailingSlash(path), site).toString();
const og = new URL('/og.png', site).toString();
const year = new Date().getFullYear();

const nav = [
  ['/wdrozenia/', 'Wdrożenia'],
  ['/audyt/', 'Audyt'],
  ['/opieka/', 'Opieka'],
  ['/ile-kosztuje/', 'Cennik'],
  ['/dla-agencji/', 'Dla agencji'],
  ['/case-studies/', 'Case studies'],
  ['/o-studiu/', 'Studio'],
];

const mobileNavExtra = [
  ['/integracje/', 'Integracje'],
  ['/branze/', 'Branże'],
  ['/przykladowy-raport/', 'Przykładowy raport'],
  ['/zaufanie/', 'Zaufanie i dane'],
];

const isActive = (href: string) => path === href || path.startsWith(href);

const miniDiagnosisActive = path === '/audyt/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}/#studio`,
  name: 'Studio Automatyzacji',
  url: site,
  email: CONTACT_EMAIL,
  description:
    'Studio automatyzacji dla MŚP e-commerce: zamówienia, zwroty, stany, faktury i korespondencja. Integracje Shoper, BaseLinker, Allegro, WooCommerce, audyt procesów i opieka techniczna.',
  areaServed: { '@type': 'Country', name: 'Polska' },
  priceRange: `0–${PRICES.scaleFrom} PLN`,
  knowsAbout: [
    'automatyzacja e-commerce',
    'integracje API',
    'Shoper',
    'BaseLinker',
    'Allegro',
    'WooCommerce',
    'n8n',
    'Make',
    'OCR',
    'raportowanie',
    'agenci AI',
    'RODO',
    'AI Act',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Usługi Studio Automatyzacji (ceny netto)',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Bezpłatna mini-diagnoza e-mailem',
        price: '0',
        priceCurrency: 'PLN',
        url: `${site}/audyt/#mini-diagnoza`,
      },
      {
        '@type': 'Offer',
        name: 'Audyt automatyzacji',
        price: String(PRICES.audit),
        priceCurrency: 'PLN',
        url: `${site}/audyt/`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Start',
        description: '1 proces, do 3 integracji, 30 dni gwarancji.',
        price: String(PRICES.start),
        priceCurrency: 'PLN',
        url: `${site}/wdrozenia/`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Growth',
        description: '3 procesy, do 6 integracji, 60 dni gwarancji.',
        price: String(PRICES.growth),
        priceCurrency: 'PLN',
        url: `${site}/wdrozenia/`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Scale',
        description: 'Od 4 procesów, integracje ERP / WMS, wycena indywidualna.',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: String(PRICES.scaleFrom),
          priceCurrency: 'PLN',
        },
        url: `${site}/wdrozenia/`,
      },
      {
        '@type': 'Offer',
        name: 'Opieka techniczna (miesięcznie)',
        price: String(PRICES.care),
        priceCurrency: 'PLN',
        url: `${site}/opieka/`,
      },
      {
        '@type': 'Offer',
        name: 'White-label dla agencji',
        price: String(PRICES.whiteLabel),
        priceCurrency: 'PLN',
        url: `${site}/dla-agencji/`,
      },
      {
        '@type': 'Offer',
        name: 'White-label dla agencji — od trzech procesów',
        price: String(PRICES.whiteLabel3plus),
        priceCurrency: 'PLN',
        url: `${site}/dla-agencji/`,
      },
    ],
  },
};

const faqLd = faq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item: { q: string; a: string }) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;
---
<!doctype html>
<html lang="pl" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {!hideCanonical && <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#F4F1E8" />
  <meta name="format-detection" content="telephone=no" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="Studio Automatyzacji" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!hideCanonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`Studio Automatyzacji: mini-diagnoza e-mailem, audyt ${P.audit} netto, wdrożenia od ${P.start} netto.`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

  <link rel="preload" href={frauncesNormal} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={frauncesExt} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={frauncesItalic} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={frauncesLight} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={interExt} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={jbmLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={jbmExt} as="font" type="font/woff2" crossorigin />

  <script is:inline>document.documentElement.classList.replace('no-js','js');</script>

  <script
    defer
    src={UMAMI_SRC}
    data-website-id={UMAMI_WEBSITE_ID}
    data-host-url={UMAMI_HOST}
    data-domains="studioautomatyzacji.pl,www.studioautomatyzacji.pl"
    data-do-not-track="true"
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</head>
<body>
  <a class="skip" href="#main">Przejdź do treści</a>

  <header class="site-head" id="site-header">
    <div class="wrap head-row">
      <a class="brand" href="/" aria-label="Studio Automatyzacji — strona główna">Studio<span>.</span>Automatyzacji</a>

      <nav class="nav-desktop" aria-label="Menu główne">
        {nav.map(([href, label]) => (
          <a
            href={href}
            class={isActive(href) ? 'is-active' : ''}
            aria-current={isActive(href) ? 'page' : undefined}
            data-umami-event={href === '/kontakt/' ? 'cta_click' : undefined}
            data-umami-event-label={href === '/kontakt/' ? 'Nawigacja: kontakt' : undefined}
          >{label}</a>
        ))}
      </nav>

      <div class="head-actions">
        <a
          class="head-cta"
          href={CONTACT_HREF}
          data-umami-event="cta_click"
          data-umami-event-label="Nagłówek: napisz do nas"
        >Napisz do nas →</a>

        <details class="menu">
          <summary>Menu</summary>
          <nav class="menu-panel" aria-label="Menu mobilne">
            {nav.map(([href, label]) => (
              <a
                href={href}
                class={isActive(href) ? 'is-active' : ''}
                aria-current={isActive(href) ? 'page' : undefined}
                data-umami-event={href === '/kontakt/' ? 'cta_click' : undefined}
                data-umami-event-label={href === '/kontakt/' ? 'Menu mobilne: kontakt' : undefined}
              >{label}</a>
            ))}
            <a href="/audyt/#mini-diagnoza" class={miniDiagnosisActive ? 'is-active' : ''} aria-current={miniDiagnosisActive ? 'page' : undefined} data-umami-event="cta_click" data-umami-event-label="Menu mobilne: mini-diagnoza">Bezpłatna mini-diagnoza</a>
            {mobileNavExtra.map(([href, label]) => (
              <a
                href={href}
                class={isActive(href) ? 'is-active' : ''}
                aria-current={isActive(href) ? 'page' : undefined}
              >{label}</a>
            ))}
            <a
              class="menu-cta"
              href={CONTACT_HREF}
              data-umami-event="cta_click"
              data-umami-event-label="Menu mobilne: napisz do nas"
            >Napisz do nas</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <p class="foot-word">Mniej ręcznie.</p>

      <div class="foot-grid">
        <div>
          <p class="foot-label">Studio</p>
          <p><a href="/o-studiu/">O studiu</a></p>
          <p><a href="/case-studies/">Realizacje</a></p>
          <p><a href="/zaufanie/">Zaufanie i dane</a></p>
          <p><a href="/kontakt/" data-umami-event="cta_click" data-umami-event-label="Stopka: kontakt">Kontakt</a></p>
        </div>

        <div>
          <p class="foot-label">Oferta</p>
          <p><a href="/audyt/#mini-diagnoza">Mini-diagnoza {P.miniDiagnosis}</a></p>
          <p><a href="/audyt/">Audyt {P.audit}</a></p>
          <p><a href="/wdrozenia/">Wdrożenia</a></p>
          <p><a href="/ile-kosztuje/">Cennik</a></p>
          <p><a href="/opieka/">Opieka {P.careMc}</a></p>
          <p><a href="/dla-agencji/">Dla agencji</a></p>
        </div>

        <div>
          <p class="foot-label">Integracje i branże</p>
          {SEO_PAGES.filter((p) => p.href.split('/').length > 2).map((p) => (
            <p><a href={p.href}>{p.title}</a></p>
          ))}
        </div>

        <div>
          <p class="foot-label">Dokumenty</p>
          <p><a href="/polityka-prywatnosci/">Polityka prywatności</a></p>
          <p><a href="/regulamin/">Regulamin</a></p>
          <p><a href="/zaufanie/#ai-act">AI Act</a></p>
          <p><a href="/zaufanie/#rodo">RODO</a></p>
        </div>

        <div>
          <p class="foot-label">Kontakt</p>
          <p>
            <a class="foot-mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </p>
          <p>
            <a href={CONTACT_HREF} data-umami-event="cta_click" data-umami-event-label="Stopka: napisz do nas">Napisz do nas</a>
            · odpowiadamy {CONTACT_RESPONSE_PHRASE}
          </p>
          <p class="small muted">Ceny netto. Aktualizacja cennika: {PRICE_UPDATED}.</p>
        </div>
      </div>

      <div class="foot-legal">
        <span>© {year} Studio Automatyzacji</span>
        {COMPANY.legalName && <span>{COMPANY.legalName}</span>}
        {COMPANY.nip && <span>NIP {COMPANY.nip}</span>}
        {COMPANY_ADDRESS && <span>{COMPANY_ADDRESS}</span>}
        <span>Ceny netto · aktualizacja {PRICE_UPDATED}</span>
        <span>Bez trackerów i cookies marketingowych</span>
      </div>
    </div>
  </footer>

  <script>
    const header = document.getElementById('site-header');
    const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    document.querySelectorAll<HTMLDetailsElement>('.menu').forEach((menu) => {
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('click', (e) => {
        if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
      });
    });

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (reduced || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('in');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      targets.forEach((el) => io.observe(el));
      setTimeout(() => targets.forEach((el) => el.classList.add('in')), 2800);
    }
  </script>
</body>
</html>
