---
import '../styles/global.css';
const { title, description, path = '/', noindex = false } = Astro.props;
const site = 'https://studioautomatyzacji.pl';
const canonical = new URL(path, site).toString();
const og = new URL('/og.png', site).toString();
const nav = [
  ['/wdrozenia', 'Oferta'],
  ['/case-studies', 'Case studies'],
  ['/o-studiu', 'O studiu'],
  ['/kontakt', 'Kontakt'],
];
---
<!doctype html>
<html lang="pl" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="Studio Automatyzacji" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#07080a" />
  <script is:inline>document.documentElement.classList.replace('no-js','js');</script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Studio Automatyzacji",
    "url": site,
    "email": "kontakt@studioautomatyzacji.pl",
    "areaServed": "PL",
    "description": "Automatyzacje, integracje API i raporty dla e-commerce oraz firm usługowych.",
    "priceRange": "890–15000 PLN",
    "knowsAbout": ["automatyzacja procesów", "integracje API", "n8n", "Make", "OCR", "agenci AI"]
  })} />
</head>
<body>
  <a href="#main" class="skip">Przejdź do treści</a>
  <div class="progress" id="progress" aria-hidden="true"></div>
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>

  <header class="site" id="site-header">
    <div class="wrap nav">
      <a class="brand" href="/"><span class="mark">SA</span>Studio <span>Automatyzacji</span></a>
      <nav class="navlinks" aria-label="Menu">
        {nav.map(([href, label]) => {
          const base = href.split('#')[0];
          const active = base === '/' ? path === '/' : path.startsWith(base);
          return <a href={href} class={active ? 'active' : ''}>{label}</a>;
        })}
      </nav>
      <div class="navcta">
        <a class="btn btn--primary" href="/audyt">Audyt — 890 zł</a>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <div class="wordmark">Studio Automatyzacji</div>
      <div class="fgrid">
        <div>
          <p class="small" style="margin-top:16px;max-width:340px">
            Integracje, raporty i procesy, które przestają być robione ręcznie.
            Stała cena, dokumentacja i 30 dni gwarancji.
          </p>
          <p class="small mono" style="margin-top:18px">Praca zdalna · cała Polska</p>
        </div>
        <div>
          <div class="mono" style="margin-bottom:14px">Oferta</div>
          <p class="small"><a href="/audyt">Audyt</a></p>
          <p class="small"><a href="/wdrozenia">Wdrożenia</a></p>
          <p class="small"><a href="/opieka">Opieka</a></p>
          <p class="small"><a href="/dla-agencji">Dla agencji</a></p>
        </div>
        <div>
          <div class="mono" style="margin-bottom:14px">Studio</div>
          <p class="small"><a href="/o-studiu">O studiu</a></p>
          <p class="small"><a href="/case-studies">Case studies</a></p>
          <p class="small"><a href="/kontakt">Kontakt</a></p>
        </div>
        <div>
          <div class="mono" style="margin-bottom:14px">Formalności</div>
          <p class="small"><a href="/polityka-prywatnosci">Polityka prywatności</a></p>
          <p class="small"><a href="/regulamin">Regulamin</a></p>
          <p class="small"><a href="mailto:kontakt@studioautomatyzacji.pl">kontakt@studioautomatyzacji.pl</a></p>
        </div>
      </div>
      <div class="legal">
        <span>© {new Date().getFullYear()} Studio Automatyzacji</span>
        <span>Bez trackerów i ciasteczek marketingowych</span>
      </div>
    </div>
  </footer>

  <script>
    import Lenis from 'lenis';
    import { inView } from 'motion';

    const header = document.getElementById('site-header');
    const progress = document.getElementById('progress');

    function onScroll() {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      if (progress) progress.style.width = (max > 0 ? (doc.scrollTop / max) * 100 : 0) + '%';
      if (header) header.classList.toggle('is-scrolled', doc.scrollTop > 12);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // awaryjne odkrycie treści, gdyby observer nie wystartował
    setTimeout(() => document.querySelectorAll('[data-reveal]:not(.in)').forEach((el) => el.classList.add('in')), 2600);

    // spotlight
    document.querySelectorAll<HTMLElement>('.card,.panel,.calc').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', e.clientX - r.left + 'px');
        el.style.setProperty('--my', e.clientY - r.top + 'px');
      });
    });

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // reveal
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      if (reduced) { el.classList.add('in'); return; }
      inView(el as HTMLElement, () => {
        el.classList.add('in');
      }, { amount: 0.12, margin: '0px 0px -60px 0px' });
    });

    // licznik
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const to = Number(el.dataset.count || 0);
      const suffix = el.dataset.suffix || '';
      let done = false;
      if (reduced) { el.textContent = to + suffix; return; }
      inView(el, () => {
        if (done) return;
        done = true;
        const t0 = performance.now();
        const dur = 1100;
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          const v = Math.round(to * (1 - Math.pow(1 - k, 3)));
          el.textContent = v + suffix;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, { amount: 0.6 });
    });

    // smooth scroll
    if (!reduced) {
      const lenis = new Lenis({ duration: 1.05, smoothWheel: true, touchMultiplier: 1.2 });
      const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
    }
  </script>
</body>
</html>

<style>
  .skip{position:absolute;left:-9999px;top:0;background:var(--accent);color:var(--accent-ink);padding:10px 16px;border-radius:0 0 8px 0;z-index:200;font-weight:600}
  .skip:focus{left:0}
</style>
