---
import '../styles/global.css';
import BookingLink from '../components/BookingLink.astro';
import {
  BOOKING_HREF,
  BOOKING_URL,
  CONTACT_EMAIL,
  PRICE_UPDATED,
  SITE_URL,
} from '../config';

const { title, description, path = '/', noindex = false } = Astro.props;

const site = SITE_URL;
const canonical = new URL(path, site).toString();
const og = new URL('/og.png', site).toString();

const nav = [
  ['/wdrozenia', 'Oferta'],
  ['/ile-kosztuje', 'Ile kosztuje'],
  ['/dla-agencji', 'Dla agencji'],
  ['/o-studiu', 'O studiu'],
  ['/kontakt', 'Kontakt'],
];

const isActive = (href: string) => {
  if (href === '/wdrozenia') {
    return ['/wdrozenia', '/audyt', '/opieka'].some((p) => path === p || path.startsWith(p + '/'));
  }
  return path === href || path.startsWith(href + '/');
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}/#studio`,
  name: 'Studio Automatyzacji',
  url: site,
  email: CONTACT_EMAIL,
  description:
    'Studio automatyzacji dla e-commerce i firm usługowych. Audyt procesów, integracje API, raporty, automatyzacje n8n i Make oraz agenci AI z kontrolą człowieka.',
  areaServed: { '@type': 'Country', name: 'Polska' },
  priceRange: '890–15000 PLN',
  knowsAbout: [
    'automatyzacja procesów',
    'integracje API',
    'n8n',
    'Make',
    'OCR',
    'raportowanie',
    'agenci AI',
    'RODO',
    'AI Act',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Usługi Studio Automatyzacji (ceny netto)',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Audyt automatyzacji',
        price: '890',
        priceCurrency: 'PLN',
        url: `${site}/audyt`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Start',
        price: '3900',
        priceCurrency: 'PLN',
        url: `${site}/wdrozenia`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Growth',
        price: '8900',
        priceCurrency: 'PLN',
        url: `${site}/wdrozenia`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Scale',
        price: '15000',
        priceCurrency: 'PLN',
        url: `${site}/wdrozenia`,
      },
      {
        '@type': 'Offer',
        name: 'Opieka techniczna',
        price: '690',
        priceCurrency: 'PLN',
        url: `${site}/opieka`,
      },
      {
        '@type': 'Offer',
        name: 'White-label dla agencji',
        price: '2500',
        priceCurrency: 'PLN',
        url: `${site}/dla-agencji`,
      },
    ],
  },
};
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#f4f0e6" />
  <meta name="format-detection" content="telephone=no" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="Studio Automatyzacji" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Studio Automatyzacji. Audyt 890 zł, wdrożenia od 3 900 zł netto." />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#main">Przejdź do treści</a>

  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href="/">
        Studio Automatyzacji
        <small>Audyt i wdrożenia</small>
      </a>

      <nav class="nav-links" aria-label="Menu główne">
        {nav.map(([href, label]) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>

      <div class="nav-cta">
        <BookingLink class="btn btn--primary" />
      </div>

      <details class="menu">
        <summary>Menu</summary>
        <nav class="menu-panel" aria-label="Menu mobilne">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
          ))}
          <a href="/zaufanie">Zaufanie i dane</a>
          <a class="btn btn--primary" href={BOOKING_HREF} target={BOOKING_URL ? '_blank' : undefined} rel={BOOKING_URL ? 'noopener noreferrer' : undefined}>
            Umów rozmowę 20 min
          </a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <p class="footer-wordmark">Studio Automatyzacji</p>
        <p>
          Integracje, raporty i procesy, które przestają być robione ręcznie.
          Stała cena, dokumentacja i kod po stronie klienta.
        </p>
      </div>

      <div class="footer-grid">
        <div>
          <h2>Studio</h2>
          <p><a href="/o-studiu">O studiu</a></p>
          <p><a href="/case-studies">Realizacje</a></p>
          <p><a href="/zaufanie">Zaufanie i dane</a></p>
          <p><a href="/kontakt">Kontakt</a></p>
        </div>
        <div>
          <h2>Oferta</h2>
          <p><a href="/ile-kosztuje">Ile kosztuje</a></p>
          <p><a href="/audyt">Audyt 890 zł</a></p>
          <p><a href="/wdrozenia">Wdrożenia</a></p>
          <p><a href="/opieka">Opieka 690 zł/mc</a></p>
          <p><a href="/dla-agencji">Dla agencji</a></p>
        </div>
        <div>
          <h2>Dokumenty</h2>
          <p><a href="/polityka-prywatnosci">Polityka prywatności</a></p>
          <p><a href="/regulamin">Regulamin</a></p>
          <p><a href="/zaufanie#ai-act">AI Act</a></p>
          <p><a href="/zaufanie#rodo">RODO</a></p>
        </div>
        <div>
          <h2>Kontakt</h2>
          <p>
            <a class="footer-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </p>
          <p><a href={BOOKING_HREF} target={BOOKING_URL ? '_blank' : undefined} rel={BOOKING_URL ? 'noopener noreferrer' : undefined}>Umów rozmowę 20 min</a></p>
          <p class="small">Ceny netto. Aktualizacja cennika: {PRICE_UPDATED}.</p>
        </div>
      </div>

      <div class="footer-legal">
        <span>© {new Date().getFullYear()} Studio Automatyzacji</span>
        <span>Ceny netto · aktualizacja {PRICE_UPDATED}</span>
        <span>Bez trackerów i cookies marketingowych</span>
      </div>
    </div>
  </footer>
</body>
</html>
