---
import '../styles/global.css';
import {
  CONTACT_EMAIL,
  CONTACT_HREF,
  CONTACT_RESPONSE,
  PRICE_UPDATED,
  SITE_URL,
  UMAMI_HOST,
  UMAMI_SRC,
  UMAMI_WEBSITE_ID,
} from '../config';

const { title, description, path = '/', noindex = false, faq = null } = Astro.props;

const site = SITE_URL;
const canonical = new URL(path, site).toString();
const og = new URL('/og.png', site).toString();

const nav = [
  ['/wdrozenia', 'Oferta'],
  ['/ile-kosztuje', 'Ile kosztuje'],
  ['/dla-agencji', 'Dla agencji'],
  ['/o-studiu', 'O studiu'],
  ['/kontakt', 'Kontakt'],
];

const isActive = (href: string) => {
  if (href === '/wdrozenia') {
    return ['/wdrozenia', '/audyt', '/opieka'].some((p) => path === p || path.startsWith(p + '/'));
  }
  return path === href || path.startsWith(href + '/');
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}/#studio`,
  name: 'Studio Automatyzacji',
  url: site,
  email: CONTACT_EMAIL,
  description:
    'Studio automatyzacji dla MŚP e-commerce: zamówienia, zwroty, stany, faktury i korespondencja. Integracje Shoper, BaseLinker, Allegro, WooCommerce, audyt procesów i opieka techniczna.',
  areaServed: { '@type': 'Country', name: 'Polska' },
  priceRange: '0–15000 PLN',
  knowsAbout: [
    'automatyzacja e-commerce',
    'integracje API',
    'Shoper',
    'BaseLinker',
    'Allegro',
    'WooCommerce',
    'n8n',
    'Make',
    'OCR',
    'raportowanie',
    'agenci AI',
    'RODO',
    'AI Act',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Usługi Studio Automatyzacji (ceny netto)',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Bezpłatna mini-diagnoza e-mailem',
        price: '0',
        priceCurrency: 'PLN',
        url: `${site}/audyt#mini-diagnoza`,
      },
      {
        '@type': 'Offer',
        name: 'Audyt automatyzacji',
        price: '890',
        priceCurrency: 'PLN',
        url: `${site}/audyt`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Start',
        price: '3900',
        priceCurrency: 'PLN',
        url: `${site}/wdrozenia`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Growth',
        price: '8900',
        priceCurrency: 'PLN',
        url: `${site}/wdrozenia`,
      },
      {
        '@type': 'Offer',
        name: 'Wdrożenie Scale',
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: '15000',
          priceCurrency: 'PLN',
        },
        url: `${site}/wdrozenia`,
      },
      {
        '@type': 'Offer',
        name: 'Opieka Basic',
        price: '390',
        priceCurrency: 'PLN',
        url: `${site}/opieka`,
      },
      {
        '@type': 'Offer',
        name: 'Opieka Standard',
        price: '690',
        priceCurrency: 'PLN',
        url: `${site}/opieka`,
      },
      {
        '@type': 'Offer',
        name: 'White-label dla agencji',
        price: '2500',
        priceCurrency: 'PLN',
        url: `${site}/dla-agencji`,
      },
    ],
  },
};

const faqLd = faq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item: { q: string; a: string }) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#f4f0e6" />
  <meta name="format-detection" content="telephone=no" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="Studio Automatyzacji" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Studio Automatyzacji: mini-diagnoza e-mailem, audyt 890 zł netto, wdrożenia od 3 900 zł netto." />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script
    defer
    src={UMAMI_SRC}
    data-website-id={UMAMI_WEBSITE_ID}
    data-host-url={UMAMI_HOST}
    data-domains="studioautomatyzacji.pl"
    data-do-not-track="true"
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</head>
<body>
  <a class="skip" href="#main">Przejdź do treści</a>

  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href="/">
        Studio Automatyzacji
        <small>Audyt i wdrożenia e-commerce</small>
      </a>

      <nav class="nav-links" aria-label="Menu główne">
        {nav.map(([href, label]) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            data-umami-event={href === '/kontakt' ? 'cta_click' : undefined}
            data-umami-event-label={href === '/kontakt' ? 'Nawigacja: kontakt' : undefined}
          >{label}</a>
        ))}
      </nav>

      <div class="nav-cta">
        <a
          class="btn btn--primary"
          href={CONTACT_HREF}
          data-umami-event="cta_click"
          data-umami-event-label="Nagłówek: napisz do nas"
        >Napisz do nas</a>
      </div>

      <details class="menu">
        <summary>Menu</summary>
        <nav class="menu-panel" aria-label="Menu mobilne">
          {nav.map(([href, label]) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              data-umami-event={href === '/kontakt' ? 'cta_click' : undefined}
              data-umami-event-label={href === '/kontakt' ? 'Menu mobilne: kontakt' : undefined}
            >{label}</a>
          ))}
          <a href="/audyt#mini-diagnoza" data-umami-event="cta_click" data-umami-event-label="Menu mobilne: mini-diagnoza">Bezpłatna mini-diagnoza</a>
          <a href="/zaufanie">Zaufanie i dane</a>
          <a
            class="btn btn--primary"
            href={CONTACT_HREF}
            data-umami-event="cta_click"
            data-umami-event-label="Menu mobilne: napisz do nas"
          >Napisz do nas</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <p class="footer-wordmark">Studio Automatyzacji</p>
        <p>
          Automatyzacje dla e-commerce: zamówienia, zwroty, stany, faktury i korespondencja.
          Stała cena, dokumentacja i kod po stronie klienta.
        </p>
      </div>

      <div class="footer-grid">
        <div>
          <h2>Studio</h2>
          <p><a href="/o-studiu">O studiu</a></p>
          <p><a href="/case-studies">Realizacje</a></p>
          <p><a href="/zaufanie">Zaufanie i dane</a></p>
          <p><a href="/kontakt" data-umami-event="cta_click" data-umami-event-label="Stopka: kontakt">Kontakt</a></p>
        </div>
        <div>
          <h2>Oferta</h2>
          <p><a href="/audyt#mini-diagnoza">Mini-diagnoza 0 zł</a></p>
          <p><a href="/audyt">Audyt 890 zł</a></p>
          <p><a href="/wdrozenia">Wdrożenia</a></p>
          <p><a href="/opieka">Opieka od 390 zł/mc</a></p>
          <p><a href="/dla-agencji">Dla agencji</a></p>
        </div>
        <div>
          <h2>Dokumenty</h2>
          <p><a href="/polityka-prywatnosci">Polityka prywatności</a></p>
          <p><a href="/regulamin">Regulamin</a></p>
          <p><a href="/zaufanie#ai-act">AI Act</a></p>
          <p><a href="/zaufanie#rodo">RODO</a></p>
        </div>
        <div>
          <h2>Kontakt</h2>
          <p>
            <a class="footer-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </p>
          <p><a href={CONTACT_HREF} data-umami-event="cta_click" data-umami-event-label="Stopka: napisz do nas">Napisz do nas</a> · odpowiedź w {CONTACT_RESPONSE}</p>
          <p class="small">Ceny netto. Aktualizacja cennika: {PRICE_UPDATED}.</p>
        </div>
      </div>

      <div class="footer-legal">
        <span>© {new Date().getFullYear()} Studio Automatyzacji</span>
        <span>Ceny netto · aktualizacja {PRICE_UPDATED}</span>
        <span>Bez trackerów i cookies marketingowych</span>
      </div>
    </div>
  </footer>
</body>
</html>
