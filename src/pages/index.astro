---
import Base from '../layouts/Base.astro';
import ContactLink from '../components/ContactLink.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Scenario from '../components/Scenario.astro';
import { homeFaq } from '../data/faq';
import { ecommerceProblems, ecommerceServices, notWorth } from '../data/content';
import { CONTACT_EMAIL, DIAGNOSIS_RESPONSE } from '../config';

const steps = [
  {
    n: '01',
    t: 'Napisz do nas',
    price: 'Formularz · e-mail',
    d: 'Krótki opis procesu, narzędzi i liczby osób. Bez kalendarza i bez prezentacji.',
    when: 'Odpowiedź w 1 dzień roboczy',
  },
  {
    n: '02',
    t: 'Mini-diagnoza e-mailem',
    price: '0 zł',
    d: 'Krótka pisemna ocena jednego procesu: czy warto automatyzować, szacunek godzin [EST] i narzędzia.',
    when: `Odpowiedź w ${DIAGNOSIS_RESPONSE}`,
  },
  {
    n: '03',
    t: 'Audyt 890 zł netto',
    price: 'Odliczany od wdrożenia',
    d: 'Mapa procesu, koszt ręcznej pracy, priorytety, ryzyka i stała wycena wdrożenia. Raport zostaje u Ciebie.',
    when: 'Raport orientacyjnie w 3 dni robocze',
  },
];

const plans = [
  {
    name: 'Start',
    scope: '1 proces',
    price: '3 900',
    desc: 'Jeden proces e-commerce, który najbardziej zjada czas.',
    feats: [
      '1 proces end-to-end',
      'do 3 integracji',
      'testy na Twoich danych',
      'dokumentacja i szkolenie',
      '30 dni gwarancji',
    ],
    href: '/kontakt?temat=wdrozenie',
    cta: 'Zapytaj o Start',
  },
  {
    name: 'Growth',
    scope: '3 procesy',
    price: '8 900',
    desc: 'Trzy procesy i raport, który je podsumowuje.',
    feats: [
      '3 procesy end-to-end',
      'dashboard lub raport cykliczny',
      'do 6 integracji',
      'alerty i obsługa błędów',
      '60 dni gwarancji',
    ],
    href: '/kontakt?temat=wdrozenie',
    cta: 'Zapytaj o Growth',
  },
  {
    name: 'Scale',
    scope: 'od 4 procesów',
    price: 'od 15 000',
    desc: 'Większe środowisko, ERP, WMS i wiele systemów.',
    feats: [
      'od 4 procesów',
      'integracje ERP / WMS',
      'wdrożenie etapami',
      'SLA w umowie',
      'opieka po odbiorze',
    ],
    href: '/kontakt?temat=wdrozenie',
    cta: 'Zapytaj o Scale',
  },
];
---
<Base
  title="Automatyzacja e-commerce: mini-diagnoza i audyt"
  description="Automatyzacje dla MŚP e-commerce: zamówienia, zwroty, stany, faktury. Bezpłatna mini-diagnoza e-mailem, audyt 890 zł odliczany od wdrożenia. Ceny netto."
  path="/"
  faq={homeFaq}
>
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <h1>Automatyzacja e-commerce, którą najpierw policzymy.</h1>
        <div class="hero-aside">
          <p class="lead">
            Zamówienia, zwroty, stany, faktury i korespondencja. Łączymy Shoper,
            BaseLinker, Allegro, WooCommerce i pocztę w procesy, które nie wymagają
            przepisywania. Zaczynamy od bezpłatnej mini-diagnozy e-mailem.
          </p>
          <div class="buttonrow">
            <ContactLink class="btn btn--primary" label="Opisz proces" />
            <a class="btn btn--ghost" href="/audyt#mini-diagnoza">Mini-diagnoza 0 zł</a>
          </div>
          <p class="small">
            Wystarczy formularz. Odpowiadamy w ciągu jednego dnia roboczego,
            a mini-diagnozę wysyłamy w {DIAGNOSIS_RESPONSE}.
          </p>
        </div>
      </div>

      <div class="hero-facts">
        <div><b>Mini-diagnoza 0 zł</b>Jeden proces, pisemna ocena e-mailem w {DIAGNOSIS_RESPONSE}.</div>
        <div><b>Audyt 890 zł netto</b>Odliczany od pierwszej faktury za wdrożenie.</div>
        <div><b>Stałe ceny netto</b>Start 3 900, Growth 8 900, Scale od 15 000 zł.</div>
        <div><b>Kod u klienta</b>Kod, dokumentacja i dostępy po opłaceniu zlecenia.</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Ręczna obsługa nie skaluje się sama.</h2>
        <p class="section-intro">
          Sześć sytuacji z e-commerce, w których proces kosztuje więcej, niż widać
          w kalendarzu. Każdą da się opisać i policzyć.
        </p>
      </div>

      <div class="problem-grid">
        {ecommerceProblems.map((p, i) => (
          <div class="problem-item">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Co automatyzujemy w e-commerce</h2>
        <p class="section-intro">
          Zaczynamy od procesu, nie od narzędzia. Zakres dobieramy do systemów,
          które już masz, i do danych, które naprawdę istnieją.
        </p>
      </div>

      <div class="service-list">
        {ecommerceServices.map((s) => (
          <div class="service-row">
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <span class="out">{s.out}</span>
          </div>
        ))}
      </div>

      <div class="section-foot">
        <a class="text-link" href="/wdrozenia">Zakres wdrożeń i pakiety</a>
        <span class="mono">Ceny netto · aktualizacja 18.10.2026</span>
      </div>
    </div>
  </section>

  <section class="section section--paper2" id="mini-diagnoza">
    <div class="wrap">
      <div class="section-head">
        <h2>Bezpłatna mini-diagnoza e-mailem</h2>
        <p class="section-intro">
          Zanim zamówisz audyt, sprawdź, czy proces w ogóle ma sens automatyzować.
          Wystarczy jeden formularz i jeden proces.
        </p>
      </div>

      <div class="split">
        <div>
          <p class="lead">
            Opisz proces, narzędzia i ile osób go wykonuje. W ciągu {DIAGNOSIS_RESPONSE}
            dostajesz e-mail z krótką pisemną oceną: czy warto automatyzować,
            ile godzin może to oszczędzić [EST] i jakich narzędzi wymaga.
          </p>
          <ul class="checklist">
            <li>Jedna odpowiedź na jeden proces, nie pełny raport.</li>
            <li>Szacunek oszczędności godzinowych oznaczony jako [EST].</li>
            <li>Bez wyceny wdrożenia z gwarancją i bez zobowiązania.</li>
            <li>Możliwa rekomendacja „nie automatyzować”.</li>
          </ul>
          <div class="buttonrow" style="margin-top:24px">
            <ContactLink class="btn btn--primary" label="Wyślij zgłoszenie" />
            <a class="btn btn--ghost" href="/audyt#porownanie">Porównaj z audytem</a>
          </div>
        </div>

        <div class="condition">
          <h3>Co dostajesz w e-mailu</h3>
          <ul class="checklist">
            <li>Ocenę, czy proces warto automatyzować teraz.</li>
            <li>Szacunek godzin do odzyskania w miesiącu [EST].</li>
            <li>Listę narzędzi i integracji do sprawdzenia.</li>
            <li>Wskazanie ryzyk i danych, których brakuje.</li>
            <li>Rekomendację: mini-diagnoza wystarczy, audyt albo stop.</li>
          </ul>
          <p class="small" style="margin:16px 0 0">
            <strong>Uczciwie o terminie:</strong> przy większej liczbie zgłoszeń odpowiedź
            może się wydłużyć. Nie używamy liczników miejsc ani sztucznych
            terminów. Kolejność wynika ze zgłoszeń, nie z presji sprzedażowej.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Ścieżka w trzech krokach</h2>
        <p class="section-intro">
          Od wiadomości do decyzji. Ceny netto, terminy orientacyjne.
        </p>
      </div>

      <div class="path path--3">
        {steps.map((s) => (
          <div class="path-step">
            <span class="n">{s.n}</span>
            <h3>{s.t}</h3>
            <p class="price">{s.price}</p>
            <p>{s.d}</p>
            <span class="when">{s.when}</span>
          </div>
        ))}
      </div>

      <div class="section-foot">
        <span class="small muted">
          Po audycie: wdrożenie Start 3 900 zł, Growth 8 900 zł albo Scale od 15 000 zł netto.
          Audyt odliczamy od pierwszej faktury.
        </span>
        <a class="text-link" href="/ile-kosztuje#sciezka">Pełne ceny i zależności</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Pakiety wdrożeń</h2>
        <p class="section-intro">
          Ceny netto, stałe przed startem. Audyt 890 zł odliczamy od pierwszej faktury.
          Płatność 50% przed startem, 50% po odbiorze.
        </p>
      </div>

      <div class="plans">
        {plans.map((p) => (
          <div class="plan">
            <div class="plan-head">
              <h3>{p.name}</h3>
              <span class="scope">{p.scope}</span>
            </div>
            <p class="price">{p.price} <small>zł netto</small></p>
            <p class="desc">{p.desc}</p>
            <ul>
              {p.feats.map((f) => <li>{f}</li>)}
            </ul>
            <a class="btn btn--ghost" href={p.href}>{p.cta}</a>
          </div>
        ))}
      </div>

      <div class="section-foot">
        <a class="text-link" href="/ile-kosztuje#porownanie">Tabela porównawcza i od czego zależy cena</a>
        <span class="mono">Audyt 890 zł · Start 3 900 zł · Growth 8 900 zł · Scale od 15 000 zł</span>
      </div>
    </div>
  </section>

  <section class="section section--paper2">
    <div class="wrap">
      <div class="section-head">
        <h2>Opieka w dwóch poziomach</h2>
        <p class="section-intro">
          Opcjonalna, miesięczna, bez rocznego zobowiązania. Wybierasz zakres reakcji,
          nie pakiet na siłę.
        </p>
      </div>

      <div class="plans plans--2">
        <div class="plan">
          <div class="plan-head">
            <h3>Basic</h3>
            <span class="scope">Aktualna oferta</span>
          </div>
          <p class="price">390 <small>zł netto/mc</small></p>
          <p class="desc">Monitoring i drobne zmiany w stałym zakresie.</p>
          <ul>
            <li>monitoring, alerty i kopie</li>
            <li>do 2 h zmian miesięcznie</li>
            <li>SLA reakcji 3 dni robocze</li>
            <li>raport miesięczny</li>
          </ul>
          <a class="btn btn--ghost" href="/kontakt?temat=opieka">Zapytaj o Basic</a>
        </div>
        <div class="plan">
          <div class="plan-head">
            <h3>Standard</h3>
            <span class="scope">Aktualna oferta</span>
          </div>
          <p class="price">690 <small>zł netto/mc</small></p>
          <p class="desc">Szybsza reakcja i stała konsultacja techniczna.</p>
          <ul>
            <li>do 5 h zmian miesięcznie</li>
            <li>SLA reakcji 1 dzień roboczy</li>
            <li>przegląd kwartalny</li>
            <li>1 h konsultacji miesięcznie</li>
          </ul>
          <a class="btn btn--ghost" href="/kontakt?temat=opieka">Zapytaj o Standard</a>
        </div>
      </div>

      <div class="section-foot">
        <a class="text-link" href="/opieka">Warunki opieki i czego nie obejmuje</a>
        <span class="mono">Basic 390 zł · Standard 690 zł netto/mc</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Policzmy na jawnych założeniach</h2>
        <p class="section-intro">
          Poniżej model, nie wynik klienta. W audycie podmieniamy te założenia
          na Twoje stawki, wolumen i czas pracy.
        </p>
      </div>
      <Scenario />
    </div>
  </section>

  <section class="section section--paper2">
    <div class="wrap">
      <div class="section-head">
        <h2>Kiedy NIE zlecać automatyzacji</h2>
        <p class="section-intro">
          Sześć sytuacji, w których mówimy „stop”. Lepiej przed audytem niż po
          wdrożeniu, które nie ma z czego się zwrócić.
        </p>
      </div>

      <div class="problem-grid">
        {notWorth.map((item, i) => (
          <div class="problem-item">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.t}</h3>
              <p>{item.d}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="note" style="margin-top:32px">
        <strong>Uczciwa ocena dopasowania.</strong> Mini-diagnoza nie jest etapem sprzedaży,
        po którym zawsze następuje oferta. Jeśli proces nie ma sensu, odpowiedź to powie.
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Jak pracujemy</h2>
        <p class="section-intro">
          Cztery zasady, które obowiązują w każdym wdrożeniu. Bez wyjątków
          dopisywanych na końcu.
        </p>
      </div>

      <div class="problem-grid">
        <div class="problem-item">
          <span class="n">01</span>
          <div>
            <h3>Człowiek zatwierdza</h3>
            <p>AI klasyfikuje, streszcza albo przygotowuje szkic. Decyzję o zamówieniu, zwrocie i płatności podejmuje człowiek.</p>
          </div>
        </div>
        <div class="problem-item">
          <span class="n">02</span>
          <div>
            <h3>Monitoring i logi</h3>
            <p>Alert po błędzie, ponowienia dla błędów przejściowych i kolejka wyjątków. Log zawiera metadane potrzebne do diagnozy.</p>
          </div>
        </div>
        <div class="problem-item">
          <span class="n">03</span>
          <div>
            <h3>Kod u klienta</h3>
            <p>Po opłaceniu zlecenia kod, dokumentacja i dostępy zostają po Twojej stronie. Nie blokujemy rozwiązania abonamentem.</p>
          </div>
        </div>
        <div class="problem-item">
          <span class="n">04</span>
          <div>
            <h3>Stały zakres i odbiór</h3>
            <p>Kryteria odbioru ustalamy przed startem. Testy na Twoich danych, 30 albo 60 dni gwarancji na usunięcie błędów w zakresie.</p>
          </div>
        </div>
      </div>

      <div class="section-foot">
        <a class="text-link" href="/zaufanie">RODO, NDA, AI Act i obsługa błędów</a>
        <span class="mono">Bez certyfikatów, których nie mamy</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <h2>Nie publikujemy wymyślonych realizacji.</h2>
          <p class="lead">
            Nie mamy jeszcze publicznych case studies. Nie wstawiamy cudzych logotypów,
            opinii ani liczb bez pomiaru.
          </p>
          <p class="muted">
            Pierwszy publiczny case powstanie po pilocie. Klient akceptuje zakres pomiaru
            przed startem, widzi cały opis przed publikacją i może go wycofać.
            Do tego czasu pokazujemy działający prototyp monitoringu cen i opisujemy metodykę.
          </p>
          <div class="buttonrow">
            <a class="btn btn--ghost" href="/case-studies">Jak powstaje pierwszy case</a>
          </div>
        </div>

        <div>
          <h2>Dane, dostęp i AI</h2>
          <ul class="checklist">
            <li><strong>RODO.</strong> Umowa powierzenia, gdy proces jej wymaga. Dostęp tylko do danych potrzebnych do zadania.</li>
            <li><strong>NDA.</strong> Na życzenie, przed przekazaniem materiałów o procesach i systemach.</li>
            <li><strong>AI Act.</strong> Człowiek zatwierdza wynik. AI nie podejmuje decyzji autonomicznych.</li>
            <li><strong>Kod i dostępy.</strong> Po opłaceniu zlecenia zostają po Twojej stronie. Dostępy wygasamy po projekcie.</li>
          </ul>
          <p class="small" style="margin-top:16px">
            <a class="text-link touch-link" href="/zaufanie">Zaufanie, dane i zgodność</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head">
        <h2>Pytania przed pierwszym e-mailem</h2>
        <p class="section-intro">
          Cena, czas, kod, dane i granice AI. Jeśli czegoś brakuje, napisz na
          <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      </div>
      <FAQ items={homeFaq} />
    </div>
  </section>

  <CTA />
</Base>
