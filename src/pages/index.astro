---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';
import { homeFaq } from '../data/faq';
import { P, PRICES } from '../data/pricing';

const protocol = [
  { n: '01', t: 'Diagnoza', d: 'Mapa procesu, pomiar czasu i lista miejsc, w których ludzie robią pracę systemu.', when: '3 dni robocze' },
  { n: '02', t: 'Projekt', d: 'Zakres, architektura i kolejność wdrożeń. Wiesz, co powstanie i co zostaje poza zakresem.', when: '2 dni robocze' },
  { n: '03', t: 'Wdrożenie', d: 'Budowa, testy na Twoich danych, uruchomienie i szkolenie. Bez „prawie działa”.', when: '5–10 dni roboczych' },
  { n: '04', t: 'Opieka', d: 'Monitoring, poprawki i miesięczny przegląd. System zostaje sprawny, kiedy nas nie ma.', when: '30 dni gwarancji' },
];

const services = [
  { n: '01', t: 'Integracje API', d: 'Sklep, BaseLinker, ERP, arkusz i poczta rozmawiają ze sobą bez pośrednika. Zamówienia, stany, ceny i statusy płyną same.', tags: ['BaseLinker', 'Shoper', 'Allegro', 'REST'] },
  { n: '02', t: 'Monitoring cen', d: 'Ceny i dostępność konkurencji codziennie rano. Zmiany powyżej progu trafiają na maila albo Telegram.', tags: ['scraping', 'alerty', 'dane'] },
  { n: '03', t: 'Raporty i dashboardy', d: 'Jeden raport zamiast pięciu plików. Liczby zgodne z systemem źródłowym, nie „mniej więcej”.', tags: ['SQL', 'PDF', 'arkusze'] },
  { n: '04', t: 'Dokumenty i OCR', d: 'Faktury, umowy i skany: odczyt, klasyfikacja i wprowadzenie do obiegu bez klikania.', tags: ['OCR', 'faktury', 'klasyfikacja'] },
  { n: '05', t: 'n8n, Make, webhooki', d: 'Łączymy narzędzia, które nie mają gotowej integracji — z powiadomieniem, logiem i obsługą błędów.', tags: ['n8n', 'Make', 'webhooki'] },
  { n: '06', t: 'Agenci AI w procesie', d: 'Klasyfikacja wiadomości, streszczenia i odpowiedzi z kontrolą człowieka. Bez halucynacji na produkcji.', tags: ['LLM', 'kontrola', 'ewaluacja'] },
];

const cases = [
  { n: '01', t: 'Strażnik Cen', tag: 'prototyp', before: 'ręczne sprawdzanie cen', after: '<b>50</b> produktów · 5 konkurentów', note: 'działa' },
  { n: '02', t: 'Integracja zamówień', tag: 'zakres', before: 'przepisywanie między systemami', after: '<b>1</b> przepływ bez klikania', note: '5–10 dni' },
  { n: '03', t: 'Raport operacyjny', tag: 'zakres', before: '5 plików i godziny scalania', after: '<b>1</b> raport o 06:00', note: 'codziennie' },
];

const plans = [
  { name: 'Start', price: P.start.replace(' zł', '').replace(/ /g, ' '), unit: 'zł netto', desc: 'Jeden proces, który najbardziej zjada czas.', feats: ['1 proces end-to-end', 'do 3 integracji API', 'testy na Twoich danych', 'dokumentacja i szkolenie', '30 dni gwarancji'], cta: 'Wybieram Start', href: '/kontakt?plan=start', hot: false },
  { name: 'Growth', price: P.growth.replace(' zł', '').replace(/ /g, ' '), unit: 'zł netto', desc: 'Trzy procesy i raport, który zastępuje arkusze.', feats: ['3 procesy end-to-end', 'dashboard lub raport cykliczny', 'do 6 integracji', 'alerty i obsługa błędów', '60 dni gwarancji'], cta: 'Wybieram Growth', href: '/kontakt?plan=growth', hot: true },
  { name: 'Scale', price: P.scaleFrom.replace(' zł', '').replace(/ /g, ' '), unit: 'zł netto', desc: 'Większe wdrożenie z wieloma systemami i zespołami.', feats: ['od 4 procesów', 'integracje ERP / WMS', 'agenci AI z kontrolą człowieka', 'wdrożenie etapami', 'opieka po odbiorze'], cta: 'Porozmawiajmy', href: '/kontakt?plan=scale', hot: false },
];
---
<Base
  title="Automatyzacja e-commerce: mini-diagnoza i audyt"
  description={`Automatyzacje dla MŚP e-commerce: zamówienia, zwroty, stany, faktury. Bezpłatna mini-diagnoza e-mailem, audyt ${P.audit} odliczany od wdrożenia. Ceny netto.`}
  path="/"
  faq={homeFaq}
>

  <section class="hero-v4">
    <div class="wrap">
      <div class="hero-top">
        <div>
          <div class="hero-kicker">Studio Automatyzacji · Olsztyn&nbsp;/&nbsp;zdalnie</div>
          <h1 data-reveal>Mniej klikania.<br /><span class="thin">Więcej</span> <em>spokoju.</em></h1>
          <p class="hero-lede" data-reveal style="--d:.08s">
            Projektujemy i wdrażamy automatyzacje dla firm, które utonęły w powtarzalnych zadaniach.
            Jeden zespół, jasny zakres, efekt, który da się policzyć.
          </p>
          <div class="hero-actions" data-reveal style="--d:.14s">
            <a class="btn" href="/audyt">Zamów audyt — {P.audit} netto</a>
            <a class="link-arrow" href="/wdrozenia">Zobacz, co wdrażamy <span>→</span></a>
          </div>
          <div class="hero-meta" data-reveal style="--d:.2s">
            <span>10+ lat w danych i automatyce</span>
            <span>Stała cena przed startem</span>
            <span>30 dni gwarancji</span>
          </div>
        </div>

        <aside class="hero-side" data-reveal style="--d:.12s">
          <span class="mono">Jak pracujemy</span>
          <div class="side-step"><b>01</b><span>Diagnoza<small>Mierzymy, ile naprawdę kosztuje ręczna praca.</small></span></div>
          <div class="side-step"><b>02</b><span>Prototyp<small>Najpierw jeden proces. Dowód, nie prezentacja.</small></span></div>
          <div class="side-step"><b>03</b><span>System<small>Dokumentacja, monitoring i przekazanie dostępu.</small></span></div>
          <p class="side-note">Bez abonamentu na start.<br />Bez godzinowego rozliczania.<br />Kod zostaje u Ciebie.</p>
        </aside>
      </div>

      <div class="hero-figure" data-reveal>
        <div class="figure-main">
          <p><span>SYSTEM,</span> NIE <em>GODZINY.</em></p>
        </div>
        <div class="figure-side">
          <span class="mono">W skrócie</span>
          <b>48 h</b>
          <small>na zakres i wycenę po rozmowie. Potem decydujesz, czy wchodzimy.</small>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-label="Technologie i narzędzia">
    <div class="marquee-track">
      {['BaseLinker','Shoper','Allegro API','n8n','Make','Google Sheets','Python','REST API','OCR','Agenci AI','SQL','Webhooki','BaseLinker','Shoper','Allegro API','n8n','Make','Google Sheets','Python','REST API','OCR','Agenci AI','SQL','Webhooki'].map((t) => <span><b>{t}</b></span>)}
    </div>
  </div>

  <section class="section protocol" aria-labelledby="protocol-title">
    <div class="wrap">
      <div class="protocol-head">
        <div>
          <p class="eyebrow">Protokół</p>
          <h2 id="protocol-title" data-reveal>Najpierw porządek.<br />Potem automatyzacja.</h2>
        </div>
        <p data-reveal>Automatyzowanie chaosu daje szybszy chaos. Dlatego każdy projekt zaczynamy od zmierzenia procesu, a kończymy na opiece, która utrzymuje efekt.</p>
      </div>
      <div class="protocol-grid">
        {protocol.map((p) => (
          <article class="protocol-item" data-reveal>
            <span class="p-num">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
            <span class="p-meta">{p.when}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="services-head">
        <div>
          <p class="eyebrow">Zakres</p>
          <h2 data-reveal>Sześć obszarów.<br />Jeden cel: mniej ręcznej pracy.</h2>
        </div>
        <div class="sh-right" data-reveal>
          <p>Nie sprzedajemy narzędzi ani licencji. Budujemy przepływ, który działa na systemach, które już masz — albo mówimy wprost, że się nie da.</p>
          <a class="link-arrow" href="/wdrozenia" style="margin-top:14px">Pełna oferta <span>→</span></a>
        </div>
      </div>

      <div class="service-list">
        {services.map((s) => (
          <a class="service" href="/wdrozenia" data-reveal>
            <span class="s-num">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <span class="s-arrow" aria-hidden="true">↗</span>
            <div class="service-tags">{s.tags.map((t) => <span>{t}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="proof-band" aria-labelledby="proof-title">
    <div class="wrap">
      <div class="proof-top">
        <div>
          <p class="eyebrow">Po co to robić</p>
          <h2 id="proof-title" data-reveal>Nie sprzedajemy godzin.<br />Sprzedajemy wynik, który da się policzyć.</h2>
        </div>
        <p data-reveal>Każde wdrożenie ma stałą cenę, zakres i moment odbioru. Jeśli proces nie zwraca się w rozsądnym czasie, mówimy to przed startem.</p>
      </div>
      <div class="numbers">
        <div class="number" data-reveal><b>10+</b><span>lat</span><small>w danych, integracjach i automatyzacji procesów.</small></div>
        <div class="number" data-reveal style="--d:.08s"><b>48 h</b><span>na wycenę</span><small>od rozmowy do zakresu i stałej ceny.</small></div>
        <div class="number" data-reveal style="--d:.16s"><b>30 dni</b><span>gwarancji</span><small>na poprawki po odbiorze. Bez ukrytych kosztów.</small></div>
      </div>
      <div class="proof-quote" data-reveal>
        <blockquote>„Dobra automatyzacja jest nudna. Rano po prostu <span>działa</span> — a nikt nie musi o niej myśleć.”</blockquote>
        <div class="pq-side">Studio Automatyzacji</div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cases-title">
    <div class="wrap">
      <div class="cases-head">
        <div>
          <p class="eyebrow">Dowody</p>
          <h2 id="cases-title" data-reveal>Zakres, nie obietnice.</h2>
        </div>
        <a class="link-arrow" href="/case-studies">Wszystkie realizacje <span>→</span></a>
      </div>
      <div class="case-rows">
        {cases.map((c) => (
          <a class="case-row" href="/case-studies" data-reveal>
            <span class="c-num">{c.n}</span>
            <h3>{c.t}</h3>
            <span class="c-tag">{c.tag}</span>
            <span class="c-before">{c.before}</span>
            <span class="c-after" set:html={c.after} />
            <span class="c-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="small muted" style="margin-top:16px;max-width:70ch">Nie publikujemy wymyślonych logotypów ani cudzych wyników. „Prototyp” oznacza rzecz, którą zbudowaliśmy i pokazujemy na żywo; „zakres” to typowy kształt wdrożenia, nie obietnica konkretnego efektu.</p>
    </div>
  </section>

  <section class="section section--tint" id="kalkulator">
    <div class="wrap">
      <div class="grid grid--2" style="gap:clamp(32px,5vw,64px);align-items:center">
        <div>
          <p class="eyebrow">Kalkulator</p>
          <h2 data-reveal style="font-size:clamp(36px,4.6vw,62px);margin-bottom:16px">Policz, ile to warte<br />w Twojej firmie.</h2>
          <p class="lead" style="margin-bottom:18px">Trzy suwaki i jedna liczba. Bez zostawiania maila i bez rozmowy z handlowcem.</p>
          <p class="small muted" style="max-width:420px">Kalkulator liczy ostrożnie: zakłada, że automatyzacja zdejmuje 70% ręcznej pracy, a stawka godzinowa to koszt pracownika wraz z narzutami.</p>
        </div>
        <div class="calc-panel">
          <div class="calc-row">
            <label for="calc-hours">Godziny ręcznej pracy tygodniowo <output id="calc-hours-v">10 h</output></label>
            <input id="calc-hours" type="range" min="1" max="60" value="10" />
          </div>
          <div class="calc-row">
            <label for="calc-cost">Koszt godziny pracy <output id="calc-cost-v">45 zł</output></label>
            <input id="calc-cost" type="range" min="30" max="200" step="5" value="45" />
          </div>
          <div class="calc-row">
            <label for="calc-people">Liczba osób w procesie <output id="calc-people-v">1</output></label>
            <input id="calc-people" type="range" min="1" max="5" value="1" />
          </div>
          <div class="calc-out">
            <div><span>Oszczędność miesięcznie</span><b id="calc-save">—</b></div>
            <div><span>Zwrot z wdrożenia</span><b id="calc-pay">—</b></div>
          </div>
          <p class="small muted" id="calc-note" style="margin:14px 0 0">Szacunek dla pakietu Start ({P.start}). Audyt {P.audit} odliczamy od wdrożenia.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="cennik" aria-labelledby="pricing-title">
    <div class="wrap">
      <div class="pricing-head">
        <div>
          <p class="eyebrow">Cennik</p>
          <h2 id="pricing-title" data-reveal>Stała cena<br />przed startem.</h2>
        </div>
        <p>Zaczynamy od audytu za {P.audit} netto. Jeśli wdrożymy projekt, kwota audytu odlicza się od pierwszej faktury.</p>
      </div>
      <div class="price-grid">
        {plans.map((p) => (
          <div class={`price-col${p.hot ? ' featured' : ''}`} data-reveal>
            <div class="pc-label"><span>{p.name}</span>{p.hot && <span>polecany</span>}</div>
            <div class="pc-price">{p.price} <small>{p.unit}</small></div>
            <p class="pc-desc">{p.desc}</p>
            <ul class="list check">
              {p.feats.map((f) => <li>{f}</li>)}
            </ul>
            <a class={`btn ${p.hot ? '' : 'btn--line'}`} href={p.href}>{p.cta}</a>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top:18px">Płatność: 50% przed startem, 50% po odbiorze. Faktura.</p>
    </div>
  </section>

  <section class="section faq-home" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="faq-head">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title" data-reveal>Pytania, które<br /> padają najczęściej.</h2>
        </div>
        <p>Jeśli nie znajdziesz tu swojego pytania, napisz — odpowiadamy w ciągu jednego dnia roboczego.</p>
      </div>
      <FAQ items={homeFaq} />
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <div class="cta-grid">
        <div>
          <p class="eyebrow">Start</p>
          <h2 data-reveal>Policzmy, ile godzin możesz <em>odzyskać.</em></h2>
          <p data-reveal>20 minut rozmowy o procesie, który najbardziej zjada czas. Bez prezentacji i bez zobowiązań. Jeśli automatyzacja nie ma sensu, powiemy to wprost.</p>
          <div class="buttonrow" data-reveal>
            <a class="btn" href="/kontakt">Umów rozmowę</a>
            <a class="link-arrow" href="mailto:kontakt@studioautomatyzacji.pl" style="color:var(--on-ink);border-color:rgba(244,241,232,.4)">Napisz maila <span>→</span></a>
          </div>
        </div>
        <div class="cta-side">
          <span class="mono">Kontakt bezpośredni</span>
          <a href="mailto:kontakt@studioautomatyzacji.pl">kontakt@studioautomatyzacji.pl</a>
          <a href="/kontakt">Formularz →</a>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ startPrice: PRICES.start }}>
    const $ = (id) => document.getElementById(id);
    const hours = $('calc-hours'), cost = $('calc-cost'), people = $('calc-people');
    const outH = document.getElementById('calc-hours-v');
    const outC = document.getElementById('calc-cost-v');
    const outP = document.getElementById('calc-people-v');
    const outSave = document.getElementById('calc-save');
    const outPay = document.getElementById('calc-pay');

    const fmt = (n) => new Intl.NumberFormat('pl-PL', { maximumFractionDigits: 0 }).format(n);

    function calc() {
      if (!hours || !cost || !people || !outSave || !outPay) return;
      const h = Number(hours.value), c = Number(cost.value), p = Number(people.value);
      if (outH) outH.textContent = h + ' h';
      if (outC) outC.textContent = c + ' zł';
      if (outP) outP.textContent = String(p);
      const monthly = h * p * 4.33 * c * 0.7;
      outSave.textContent = fmt(monthly) + ' zł';
      const payback = startPrice / monthly;
      outPay.textContent = payback <= 24 ? payback.toFixed(1).replace('.', ',') + ' mies.' : 'ponad 24 mies.';
    }
    [hours, cost, people].forEach((el) => el && el.addEventListener('input', calc));
    calc();
  </script>

</Base>
