---
import Base from '../layouts/Base.astro';
import BookingLink from '../components/BookingLink.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Scenario from '../components/Scenario.astro';
import { homeFaq } from '../data/faq';
import { CONTACT_EMAIL } from '../config';

const problems = [
  {
    t: 'Zamówienia przepisywane między systemami',
    d: 'Sklep, BaseLinker i arkusz mają dane, ale ktoś przenosi je ręcznie. Im więcej kanałów, tym więcej okazji do pomyłki.',
  },
  {
    t: 'Stany i statusy aktualizowane po fakcie',
    d: 'Magazyn wie jedno, sklep drugie, a klient trzecie. Ręczna aktualizacja rozjeżdża się w ciągu dnia.',
  },
  {
    t: 'Ceny konkurencji sprawdzane rzadko',
    d: 'Zmiana u konkurenta wychodzi po tygodniu, bo sprawdzanie cen to osobne pół dnia pracy.',
  },
  {
    t: 'Raport składany z pięciu plików',
    d: 'Zanim trafi do decyzji, trzeba scalić eksporty i poprawić to, co się nie zgadza. Wersji jest kilka.',
  },
  {
    t: 'Dokumenty czekają w skrzynce',
    d: 'Faktury i skany leżą w folderze „do zrobienia”, bo nikt nie ma czasu ich klasyfikować i wpisywać.',
  },
  {
    t: 'Proces zna jedna osoba',
    d: 'Urlop albo zmiana pracy zatrzymuje pracę. Wiedza nie jest w dokumentacji, tylko w czyjejś głowie.',
  },
];

const services = [
  {
    t: 'Integracje API',
    d: 'Sklep, BaseLinker, ERP, arkusz i poczta wymieniają dane bez przepisywania. Zamówienia, stany, ceny i statusy płyną jednym torem.',
    out: 'Mniej ręcznego przepisywania',
  },
  {
    t: 'Monitoring cen i dostępności',
    d: 'Cykliczne zbieranie cen i stanów z listy produktów. Zmiana powyżej progu trafia na maila albo Telegram.',
    out: 'Reakcja przed podwyżką',
  },
  {
    t: 'Raporty i dashboardy',
    d: 'Jeden raport zamiast pięciu plików. Liczby zgodne z systemem źródłowym, z jasną definicją każdej kolumny.',
    out: 'Decyzje na bieżących danych',
  },
  {
    t: 'Dokumenty i OCR',
    d: 'Faktury, skany i umowy: odczyt, klasyfikacja i wprowadzenie do obiegu. Wyjątki trafiają do człowieka.',
    out: 'Mniej wpisywania',
  },
  {
    t: 'n8n, Make, webhooki',
    d: 'Łączymy narzędzia bez gotowej integracji. Z logiem, powiadomieniem i obsługą błędów, nie tylko ścieżką szczęśliwą.',
    out: 'Powtarzalne procesy',
  },
  {
    t: 'AI z kontrolą człowieka',
    d: 'Klasyfikacja wiadomości, streszczenia i szkice odpowiedzi. AI przygotowuje wynik, człowiek go zatwierdza.',
    out: 'Szybciej, ale decyzja u człowieka',
  },
];

const steps = [
  {
    n: '01',
    t: 'Bezpłatna rozmowa',
    price: '0 zł · 20 min',
    d: 'Ustalamy, który proces ma sens automatyzować i czy w Twoim przypadku to się w ogóle opłaca.',
    when: '20 minut',
  },
  {
    n: '02',
    t: 'Audyt',
    price: '890 zł netto, odliczane od wdrożenia',
    d: 'Mapa procesu, koszt ręcznej pracy, priorytety, ryzyka i wycena wdrożenia. Raport zostaje u Ciebie.',
    when: 'Raport orientacyjnie w 3 dni robocze',
  },
  {
    n: '03',
    t: 'Wdrożenie',
    price: 'od 3 900 zł netto',
    d: 'Budowa, testy na Twoich danych, dokumentacja i przekazanie dostępów. Stała cena przed startem.',
    when: 'Orientacyjnie 5–10 dni roboczych',
  },
  {
    n: '04',
    t: 'Opieka',
    price: '690 zł netto/mc, opcjonalnie',
    d: 'Monitoring, poprawki i miesięczny raport. Bez rocznego zobowiązania, z miesięcznym wypowiedzeniem.',
    when: 'Miesiąc do miesiąca',
  },
];

const plans = [
  {
    name: 'Start',
    scope: '1 proces',
    price: '3 900',
    desc: 'Jeden proces, który najbardziej zjada czas.',
    feats: [
      '1 proces end-to-end',
      'do 3 integracji',
      'testy na Twoich danych',
      'dokumentacja i szkolenie',
      '30 dni gwarancji',
    ],
    href: '/kontakt?plan=start',
    cta: 'Zapytaj o Start',
  },
  {
    name: 'Growth',
    scope: '3 procesy',
    price: '8 900',
    desc: 'Trzy procesy i raport, który je podsumowuje.',
    feats: [
      '3 procesy end-to-end',
      'dashboard lub raport cykliczny',
      'do 6 integracji',
      'alerty i obsługa błędów',
      '60 dni gwarancji',
    ],
    href: '/kontakt?plan=growth',
    cta: 'Zapytaj o Growth',
  },
  {
    name: 'Scale',
    scope: 'od 4 procesów',
    price: 'od 15 000',
    desc: 'Większe środowisko, ERP i wiele systemów.',
    feats: [
      'od 4 procesów',
      'integracje ERP / WMS',
      'wdrożenie etapami',
      'SLA w umowie',
      'opieka po odbiorze',
    ],
    href: '/kontakt?plan=scale',
    cta: 'Zapytaj o Scale',
  },
];
---
<Base
  title="Studio Automatyzacji: audyt, integracje i wdrożenia"
  description="Automatyzacje dla e-commerce i firm usługowych. Bezpłatna rozmowa 20 min, audyt 890 zł odliczany od wdrożenia, pakiety od 3 900 zł netto. Stała cena, kod u klienta."
  path="/"
>
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <h1>Automatyzacja, którą najpierw policzymy.</h1>
        <div class="hero-aside">
          <p class="lead">
            Projektujemy integracje i procesy dla e-commerce oraz firm usługowych.
            Zaczynamy od bezpłatnej rozmowy 20 minut, potem audyt za 890 zł.
            Wdrożenie ma stałą cenę, a kod zostaje u Ciebie.
          </p>
          <div class="buttonrow">
            <BookingLink class="btn btn--primary" />
            <a class="btn btn--ghost" href="/ile-kosztuje">Zobacz cennik</a>
          </div>
          <p class="small">Bez prezentacji. Rozmowa o jednym procesie, który chcesz oddać maszynie.</p>
        </div>
      </div>

      <div class="hero-facts">
        <div><b>Stałe ceny netto</b>Podane przed startem, nie po fakturze.</div>
        <div><b>Audyt 890 zł</b>Odliczany od pierwszej faktury za wdrożenie.</div>
        <div><b>Kod u klienta</b>Kod, dokumentacja i dostępy po opłaceniu zlecenia.</div>
        <div><b>NDA na życzenie</b>Podpisujemy przed przekazaniem materiałów.</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Ręczna praca nie znika sama.</h2>
        <p class="section-intro">
          Sześć sytuacji, w których proces kosztuje więcej, niż widać w kalendarzu.
          Każdą da się opisać i policzyć.
        </p>
      </div>

      <div class="problem-grid">
        {problems.map((p, i) => (
          <div class="problem-item">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Co automatyzujemy</h2>
        <p class="section-intro">
          Zaczynamy od procesu, nie od narzędzia. Zakres dobieramy do systemów,
          które już masz, i do danych, które naprawdę istnieją.
        </p>
      </div>

      <div class="service-list">
        {services.map((s) => (
          <div class="service-row">
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <span class="out">{s.out}</span>
          </div>
        ))}
      </div>

      <div class="section-foot">
        <a class="text-link" href="/wdrozenia">Zakres wdrożeń i pakiety</a>
        <span class="mono">Ceny netto · aktualizacja 18.10.2026</span>
      </div>
    </div>
  </section>

  <section class="section section--paper2">
    <div class="wrap">
      <div class="section-head">
        <h2>Od rozmowy do opieki</h2>
        <p class="section-intro">
          Cztery kroki, jedna ścieżka. Ceny netto, terminy orientacyjne.
          Termin wdrożenia liczymy od przekazania dostępów i danych testowych.
        </p>
      </div>

      <div class="path">
        {steps.map((s) => (
          <div class="path-step">
            <span class="n">{s.n}</span>
            <h3>{s.t}</h3>
            <p class="price">{s.price}</p>
            <p>{s.d}</p>
            <span class="when">{s.when}</span>
          </div>
        ))}
      </div>

      <div class="section-foot">
        <span class="small muted">Audyt jest osobną usługą. Jeśli nie dojdzie do wdrożenia, raport zostaje u Ciebie.</span>
        <a class="text-link" href="/ile-kosztuje#sciezka">Pełne ceny i zależności</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Pakiety wdrożeń</h2>
        <p class="section-intro">
          Ceny netto, stałe przed startem. Audyt 890 zł odliczamy od pierwszej faktury.
          Płatność 50% przed startem, 50% po odbiorze.
        </p>
      </div>

      <div class="plans">
        {plans.map((p) => (
          <div class="plan">
            <div class="plan-head">
              <h3>{p.name}</h3>
              <span class="scope">{p.scope}</span>
            </div>
            <p class="price">{p.price} <small>zł netto</small></p>
            <p class="desc">{p.desc}</p>
            <ul>
              {p.feats.map((f) => <li>{f}</li>)}
            </ul>
            <a class="btn btn--ghost" href={p.href}>{p.cta}</a>
          </div>
        ))}
      </div>

      <div class="section-foot">
        <a class="text-link" href="/ile-kosztuje#porownanie">Tabela porównawcza i od czego zależy cena</a>
        <span class="mono">Audyt 890 zł · Start 3 900 zł · Growth 8 900 zł · Scale od 15 000 zł</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Policzmy na jawnych założeniach</h2>
        <p class="section-intro">
          Poniżej model, nie wynik klienta. W audycie podmieniamy te założenia
          na Twoje stawki, wolumen i czas pracy.
        </p>
      </div>
      <Scenario />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <h2>Nie publikujemy wymyślonych realizacji.</h2>
          <p class="lead">
            Nie mamy jeszcze publicznych case studies. Nie wstawiamy cudzych logotypów,
            opinii ani liczb bez pomiaru.
          </p>
          <p class="muted">
            Pierwszy publiczny case powstanie po pilocie. Klient akceptuje zakres pomiaru
            przed startem, widzi cały opis przed publikacją i może go wycofać.
            Do tego czasu pokazujemy działający prototyp monitoringu cen i opisujemy metodykę.
          </p>
          <div class="buttonrow">
            <a class="btn btn--ghost" href="/case-studies">Jak powstaje pierwszy case</a>
          </div>
        </div>

        <div>
          <h2>Dane, dostęp i AI</h2>
          <ul class="checklist">
            <li><strong>RODO.</strong> Umowa powierzenia, gdy proces jej wymaga. Dostęp tylko do danych potrzebnych do zadania.</li>
            <li><strong>NDA.</strong> Na życzenie, przed przekazaniem materiałów o procesach i systemach.</li>
            <li><strong>AI Act.</strong> Człowiek zatwierdza wynik. AI nie podejmuje decyzji autonomicznych.</li>
            <li><strong>Kod i dostępy.</strong> Po opłaceniu zlecenia zostają po Twojej stronie. Dostępy wygasamy po projekcie.</li>
          </ul>
          <p class="small" style="margin-top:16px">
            <a class="text-link touch-link" href="/zaufanie">Zaufanie, dane i zgodność</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Pytania przed pierwszą rozmową</h2>
        <p class="section-intro">
          Krótkie odpowiedzi o cenie, terminach, kodzie i granicach AI.
          Jeśli czegoś brakuje, napisz na
          <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      </div>
      <FAQ items={homeFaq} />
    </div>
  </section>

  <CTA />
</Base>
