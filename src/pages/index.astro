---
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import FAQ from '../components/FAQ.astro';
import { homeFaq } from '../data/faq';
import { P } from '../data/pricing';

const services = [
  {
    n: '01',
    t: 'Integracje API',
    d: 'Sklep, BaseLinker, ERP, arkusz i poczta rozmawiają ze sobą bez pośrednika. Zamówienia, stany, ceny i statusy płyną same.',
    tags: ['BaseLinker', 'Shoper', 'Allegro', 'REST'],
  },
  {
    n: '02',
    t: 'Monitoring cen',
    d: 'Ceny i dostępność konkurencji codziennie rano. Zmiany powyżej progu trafiają na maila albo Telegram.',
    tags: ['scraping', 'alerty', 'dane'],
  },
  {
    n: '03',
    t: 'Raporty i dashboardy',
    d: 'Jeden raport zamiast pięciu plików. Liczby zgodne z systemem źródłowym, nie „mniej więcej”.',
    tags: ['SQL', 'PDF', 'arkusze'],
  },
  {
    n: '04',
    t: 'Dokumenty i OCR',
    d: 'Faktury, umowy i skany: odczyt, klasyfikacja i wprowadzenie do obiegu bez klikania.',
    tags: ['OCR', 'faktury', 'klasyfikacja'],
  },
  {
    n: '05',
    t: 'n8n, Make, webhooki',
    d: 'Łączymy narzędzia, które nie mają gotowej integracji — z powiadomieniem, logiem i obsługą błędów.',
    tags: ['n8n', 'Make', 'webhooki'],
  },
  {
    n: '06',
    t: 'Agenci AI w procesie',
    d: 'Klasyfikacja wiadomości, streszczenia i odpowiedzi z kontrolą człowieka. Bez halucynacji na produkcji.',
    tags: ['LLM', 'kontrola', 'ewaluacja'],
  },
];

const steps = [
  { n: '01', t: 'Diagnoza', d: 'Mapa procesu, pomiar czasu i lista miejsc, w których ludzie robią pracę systemu.', when: '3 dni robocze' },
  { n: '02', t: 'Projekt', d: 'Zakres, architektura i kolejność wdrożeń. Wiesz, co powstanie i co zostaje poza zakresem.', when: '2 dni robocze' },
  { n: '03', t: 'Wdrożenie', d: 'Budowa, testy na Twoich danych, uruchomienie i szkolenie. Bez „prawie działa”.', when: '5–10 dni roboczych' },
  { n: '04', t: 'Opieka', d: 'Monitoring, poprawki i miesięczny przegląd. System zostaje sprawny, kiedy nas nie ma.', when: '30 dni gwarancji' },
];

const flow = [
  { n: '01', system: 'Sklep', what: 'Zamówienie i płatność', tag: 'webhook / API' },
  { n: '02', system: 'BaseLinker', what: 'Kolejka i mapowanie', tag: 'API' },
  { n: '03', system: 'ERP', what: 'Stany i faktura', tag: 'REST / SQL' },
  { n: '04', system: 'Raport', what: '06:00 i wyjątki', tag: 'e-mail / Telegram' },
];

const cases = [
  {
    n: '01',
    t: 'Strażnik cen',
    tag: 'prototyp',
    live: true,
    href: '/case-studies#straznik-cen',
    before: 'Ręczne sprawdzanie cen w pięciu sklepach. 50 produktów, godzina dziennie, arkusze rozjeżdżają się między osobami.',
    after: 'Jeden przebieg rano. Alert przy zmianie powyżej progu, historia odczytów i link do źródła.',
    note: 'Prototyp wewnętrzny',
  },
  {
    n: '02',
    t: 'Integracja zamówień',
    tag: 'zakres',
    live: false,
    href: '/case-studies#integracja-zamowien',
    before: 'Przepisywanie zamówień między sklepem, BaseLinker i ERP. Literówki, opóźnienia i brak jednego statusu.',
    after: 'Jeden przepływ: zamówienie, stan, status i faktura bez przepisywania.',
    note: 'Zakres wdrożenia',
  },
  {
    n: '03',
    t: 'Raport operacyjny',
    tag: 'zakres',
    live: false,
    href: '/case-studies#raport-operacyjny',
    before: 'Pięć plików i godziny scalania. Raport gotowy po południu, często z inną liczbą niż w systemie.',
    after: 'Jeden raport o 06:00. Te same liczby co w źródle, z logiem skąd przyszły.',
    note: 'Zakres wdrożenia',
  },
];

const plans = [
  {
    name: 'Start',
    from: false,
    amount: P.start.replace(' zł', ''),
    price: P.start,
    desc: 'Jeden proces, który najbardziej zjada czas.',
    feats: ['1 proces end-to-end', 'do 3 integracji API', 'testy na Twoich danych', 'dokumentacja i szkolenie', '30 dni gwarancji'],
    cta: 'Wybieram Start',
    href: '/kontakt?plan=start',
    hot: false,
  },
  {
    name: 'Growth',
    from: false,
    amount: P.growth.replace(' zł', ''),
    price: P.growth,
    desc: 'Trzy procesy i raport, który zastępuje arkusze.',
    feats: ['3 procesy end-to-end', 'dashboard lub raport cykliczny', 'do 6 integracji', 'alerty i obsługa błędów', '60 dni gwarancji'],
    cta: 'Wybieram Growth',
    href: '/kontakt?plan=growth',
    hot: true,
  },
  {
    name: 'Scale',
    from: true,
    amount: P.scaleFrom.replace('od ', '').replace(' zł', ''),
    price: P.scaleFrom,
    desc: 'Większe wdrożenie z wieloma systemami i zespołami.',
    feats: ['od 4 procesów', 'integracje ERP / WMS', 'agenci AI z kontrolą człowieka', 'wdrożenie etapami', 'opieka po odbiorze'],
    cta: 'Porozmawiajmy',
    href: '/kontakt?plan=scale',
    hot: false,
  },
];

const numbers = [
  { b: '10+ lat', s: 'w danych, integracjach i automatyzacji procesów.' },
  { b: '48 h', s: 'od rozmowy do zakresu i stałej ceny.' },
  { b: '30 dni', s: 'gwarancji na poprawki po odbiorze. Bez ukrytych kosztów.' },
];
---

<Base
  title="Automatyzacja e-commerce: mini-diagnoza i audyt"
  description={`Automatyzacje dla MŚP e-commerce: zamówienia, zwroty, stany, faktury. Bezpłatna mini-diagnoza e-mailem, audyt ${P.audit} odliczany od wdrożenia. Ceny netto.`}
  path="/"
  faq={homeFaq}
>
  <section class="sa-hero">
    <div class="wrap">
      <div class="sa-hero-grid">
        <div class="sa-hero-copy">
          <p class="sa-kicker"><span>01</span> Automatyzacja procesów</p>
          <h1 class="sa-display" data-reveal>
            Mniej klikania.<br />
            <em>Więcej</em> spokoju.
          </h1>
          <p class="sa-lede" data-reveal style="--d:.07s">
            Projektujemy i wdrażamy automatyzacje dla firm, które utonęły w powtarzalnych zadaniach.
            Jeden zespół, jasny zakres, efekt, który da się policzyć.
          </p>
          <div class="sa-actions" data-reveal style="--d:.13s">
            <a class="btn btn--primary" href="/audyt" data-umami-event="cta_click" data-umami-event-label="Hero: audyt">
              Zamów audyt — {P.audit} netto
            </a>
            <a class="text-link" href="/wdrozenia">
              Zobacz, co wdrażamy <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <aside class="sa-sheet" data-reveal style="--d:.18s" aria-label="Jak pracujemy">
          <div class="sa-sheet-head">
            <span>Jak pracujemy</span>
            <span class="sa-stamp">48 h</span>
          </div>
          <ol class="sa-sheet-list">
            <li><b>01</b><div><strong>Diagnoza</strong><span>Mierzymy, ile naprawdę kosztuje ręczna praca.</span></div></li>
            <li><b>02</b><div><strong>Prototyp</strong><span>Najpierw jeden proces. Dowód, nie prezentacja.</span></div></li>
            <li><b>03</b><div><strong>System</strong><span>Dokumentacja, monitoring i przekazanie dostępu.</span></div></li>
          </ol>
          <p class="sa-sheet-foot">Bez abonamentu na start · Kod zostaje u Ciebie</p>
        </aside>
      </div>

      <dl class="sa-facts">
        <div><dt>10+ lat</dt><dd>w danych i automatyzacji</dd></div>
        <div><dt>48 h</dt><dd>na zakres i stałą cenę</dd></div>
        <div><dt>30 dni</dt><dd>gwarancji po odbiorze</dd></div>
        <div><dt>{P.miniDiagnosis}</dt><dd>za mini-diagnozę e-mailem</dd></div>
      </dl>

      <nav class="sa-toc" aria-label="Spis treści strony">
        <span class="sa-toc-label">Spis</span>
        <a href="#zakres">Zakres</a>
        <a href="#przeplyw">Przepływ</a>
        <a href="#protokol">Protokół</a>
        <a href="#realizacje">Realizacje</a>
        <a href="#dla-kogo">Dla kogo</a>
        <a href="#pakiety">Pakiety</a>
        <a href="#faq">Pytania</a>
      </nav>
    </div>
  </section>

  <div class="marquee" aria-label="Technologie i narzędzia">
    <div class="marquee-track">
      {['BaseLinker','Shoper','Allegro API','n8n','Make','Google Sheets','Python','REST API','OCR','Agenci AI','SQL','Webhooki','BaseLinker','Shoper','Allegro API','n8n','Make','Google Sheets','Python','REST API','OCR','Agenci AI','SQL','Webhooki'].map((t) => <span><b>{t}</b></span>)}
    </div>
  </div>

  <section class="section section--plain" id="zakres" aria-labelledby="zakres-title">
    <div class="wrap">
      <header class="sa-head">
        <div>
          <p class="sa-kicker"><span>02</span> Zakres</p>
          <h2 id="zakres-title" data-reveal>Sześć obszarów.<br />Jeden cel: mniej ręcznej pracy.</h2>
        </div>
        <p data-reveal>
          Nie sprzedajemy narzędzi ani licencji. Budujemy przepływ, który działa na systemach,
          które już masz — albo mówimy wprost, że się nie da.
        </p>
      </header>

      <ol class="sa-index">
        {services.map((s) => (
          <li data-reveal>
            <a href="/wdrozenia">
              <span class="sa-index-num">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <span class="sa-tags">{s.tags.map((t) => <span>{t}</span>)}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--paper2" id="przeplyw" aria-labelledby="flow-title">
    <div class="wrap">
      <header class="sa-head">
        <div>
          <p class="sa-kicker"><span>03</span> Przepływ</p>
          <h2 id="flow-title" data-reveal>Jedno zamówienie.<br /><em>Cztery</em> systemy.</h2>
        </div>
        <p data-reveal>
          Tak wygląda typowy przepływ. Każdy krok ma log, limit i obsługę błędu —
          a Ty widzisz tylko wynik.
        </p>
      </header>

      <ol class="sa-flow">
        {flow.map((f) => (
          <li data-reveal>
            <span class="sa-flow-num">{f.n}</span>
            <strong>{f.system}</strong>
            <p>{f.what}</p>
            <span class="sa-flow-tag">{f.tag}</span>
          </li>
        ))}
      </ol>
      <p class="note" style="margin-top:22px">
        Schemat poglądowy. Zakres integracji zależy od systemów, które już masz;
        nie obiecujemy konkretnego efektu bez pomiaru.
      </p>
    </div>
  </section>

  <section class="section" id="protokol" aria-labelledby="protokol-title">
    <div class="wrap">
      <header class="sa-head">
        <div>
          <p class="sa-kicker"><span>04</span> Protokół</p>
          <h2 id="protokol-title" data-reveal>Najpierw porządek.<br />Potem automatyzacja.</h2>
        </div>
        <p data-reveal>
          Automatyzowanie chaosu daje szybszy chaos. Dlatego każdy projekt zaczynamy od
          zmierzenia procesu, a kończymy na opiece, która utrzymuje efekt.
        </p>
      </header>

      <ol class="sa-steps">
        {steps.map((s) => (
          <li data-reveal>
            <span class="sa-step-num">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <span class="sa-step-time">{s.when}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sa-band" aria-labelledby="zasada-title">
    <div class="wrap">
      <p class="sa-band-kicker">Zasada</p>
      <p class="sa-band-word" id="zasada-title" data-reveal>System,<br />nie <em>godziny.</em></p>
      <div class="sa-band-grid">
        {numbers.map((n) => (
          <div data-reveal><b>{n.b}</b><small>{n.s}</small></div>
        ))}
      </div>
      <blockquote data-reveal>
        „Dobra automatyzacja jest nudna. Rano po prostu <span>działa</span> —
        a nikt nie musi o niej myśleć.”
      </blockquote>
    </div>
  </section>

  <section class="section" id="realizacje" aria-labelledby="realizacje-title">
    <div class="wrap">
      <header class="sa-head">
        <div>
          <p class="sa-kicker"><span>05</span> Realizacje</p>
          <h2 id="realizacje-title" data-reveal>Zakres, nie obietnice.</h2>
        </div>
        <p data-reveal>
          Pokazujemy to, co zbudowaliśmy i co mieści się w zakresie wdrożenia.
          Bez wymyślonych logotypów i bez wyników, których nie zmierzyliśmy.
        </p>
      </header>

      <div class="sa-cases">
        {cases.map((c) => (
          <a class="sa-case" href={c.href} data-reveal data-umami-event="case_open" data-umami-event-label={c.t}>
            <div class="sa-case-top">
              <span class:list={['sa-case-tag', c.live && 'sa-case-tag--live']}>{c.tag}</span>
              <span class="sa-index-num">{c.n}</span>
            </div>
            <h3>{c.t}</h3>
            <div class="sa-case-ba">
              <div><em>Było</em><span>{c.before}</span></div>
              <div><em>Jest</em><span>{c.after}</span></div>
            </div>
            <div class="sa-case-foot"><span>{c.note}</span><span>Czytaj →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <section class="section" id="dla-kogo" aria-labelledby="dla-kogo-title">
    <div class="wrap">
      <header class="sa-head">
        <div>
          <p class="sa-kicker"><span>06</span> Dla kogo</p>
          <h2 id="dla-kogo-title" data-reveal>Tam, gdzie ludzie<br />przepisują dane.</h2>
        </div>
        <p data-reveal>
          Trzy środowiska, w których automatyzacja zwraca się najszybciej. Jeśli Twojej branży
          nie ma na liście — napisz i tak, sprawdzimy proces.
        </p>
      </header>

      <div class="sa-audience">
        <a href="/branze/sklepy-wielokanalowe" data-reveal>
          <span class="sa-audience-num">01</span>
          <h3>Sklepy wielokanałowe</h3>
          <p>Zamówienia, stany i zwroty z Allegro, Shopera i BaseLinkera w jednym przepływie — bez przepisywania między kartami.</p>
          <span class="sa-audience-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/branze/hurtownie-b2b" data-reveal>
          <span class="sa-audience-num">02</span>
          <h3>Hurtownie B2B</h3>
          <p>Cenniki, dostępność i zamówienia od stałych klientów. Oferta generowana z jednego źródła cen.</p>
          <span class="sa-audience-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/branze/biura-rachunkowe" data-reveal>
          <span class="sa-audience-num">03</span>
          <h3>Biura rachunkowe</h3>
          <p>Dokumenty z poczty i skanów do jednej kolejki: odczyt, klasyfikacja i wprowadzenie bez klikania.</p>
          <span class="sa-audience-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <p class="note" style="margin-top:26px">
        Jak pracujemy z danymi i AI: <a href="/zaufanie">zaufanie, RODO i AI Act</a>.
      </p>
    </div>
  </section>

  <section class="section section--paper2" id="pakiety" aria-labelledby="pakiety-title">
    <div class="wrap">
      <header class="sa-head">
        <div>
          <p class="sa-kicker"><span>07</span> Pakiety</p>
          <h2 id="pakiety-title" data-reveal>Stała cena.<br />Zakres przed startem.</h2>
        </div>
        <p data-reveal>
          Ceny netto. Audyt {P.audit} odliczamy od wdrożenia. Opieka {P.careMc} —
          monitoring, poprawki i miesięczny przegląd.
        </p>
      </header>

      <div class="sa-plans">
        {plans.map((p) => (
          <article class:list={['sa-plan', p.hot && 'sa-plan--hot']} data-reveal>
            {p.hot && <span class="sa-plan-flag">Najczęściej wybierany</span>}
            <p class="sa-plan-name">{p.name}</p>
            <div class="sa-plan-price">
              {p.from && <span class="sa-plan-from">od</span>}
              <b>{p.amount}</b>
              <span>zł netto</span>
            </div>
            <p class="sa-plan-desc">{p.desc}</p>
            <ul>{p.feats.map((f) => <li>{f}</li>)}</ul>
            <a class="btn btn--ghost" href={p.href} data-umami-event="cta_click" data-umami-event-label={`Pakiet: ${p.name}`}>
              {p.cta}
            </a>
          </article>
        ))}
      </div>

      <p class="note" style="margin-top:24px">
        Pełne warunki, zakresy i przykłady wycen: <a href="/ile-kosztuje">cennik</a>.
        Płatność po odbiorze etapu, faktura VAT.
      </p>
    </div>
  </section>

  <section class="section" id="kalkulator" aria-labelledby="kalkulator-title">
    <div class="wrap">
      <header class="sa-head">
        <div>
          <p class="sa-kicker"><span>08</span> Rachunek</p>
          <h2 id="kalkulator-title" data-reveal>Sprawdź, czy to się zwraca.</h2>
        </div>
        <p data-reveal>
          Policz oszczędność przy swoim wolumenie i stawce. Wynik liczy się w przeglądarce —
          nic nie wysyłamy i nie zapisujemy.
        </p>
      </header>
      <Calculator />
    </div>
  </section>

  <section class="section section--plain" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <header class="sa-head">
        <div>
          <p class="sa-kicker"><span>09</span> Pytania</p>
          <h2 id="faq-title" data-reveal>Zanim zapytasz.</h2>
        </div>
        <p data-reveal>
          Najczęstsze wątpliwości. Jeśli czegoś brakuje — napisz, odpowiadamy w ciągu jednego dnia roboczego.
        </p>
      </header>
      <FAQ items={homeFaq} />
    </div>
  </section>

  <section class="sa-cta" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="sa-cta-grid">
        <div>
          <p class="sa-kicker"><span>10</span> Start</p>
          <h2 id="cta-title" data-reveal>Zacznijmy od <em>jednego</em> procesu.</h2>
          <p data-reveal>
            Opisz, co dziś robisz ręcznie. Odpowiemy, czy da się to oddać systemowi,
            ile to potrwa i ile będzie kosztować — w ciągu jednego dnia roboczego.
          </p>
        </div>
        <div class="sa-cta-actions" data-reveal>
          <a class="btn btn--primary" href="/audyt" data-umami-event="cta_click" data-umami-event-label="Stopka CTA: audyt">
            Zamów audyt — {P.audit} netto
          </a>
          <a class="text-link" href="/kontakt">Napisz do nas <span aria-hidden="true">→</span></a>
          <a class="sa-cta-mail" href="/audyt#mini-diagnoza">albo zacznij od bezpłatnej mini-diagnozy</a>
        </div>
      </div>
    </div>
  </section>
</Base>
