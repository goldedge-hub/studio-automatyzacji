---
import Base from '../layouts/Base.astro';
---
<Base
  title="Nie ma takiej strony | Studio Automatyzacji"
  description="Ta strona nie istnieje. Przejdź na stronę główną, zobacz cennik automatyzacji, mini-diagnozę albo napisz do nas e-mailem."
  path="/404"
  noindex={true}
  hideCanonical={true}
>
  <section class="page-head">
    <div class="wrap narrow">
      <div class="meta-line">
        <span>404</span>
        <span>Adres nie istnieje</span>
      </div>
      <h1>Tej strony nie ma</h1>
      <p class="lead">
        Adres mógł się zmienić albo jest w nim literówka. Wróć na stronę główną,
        zobacz cennik albo napisz.
      </p>
      <div class="buttonrow">
        <a class="btn btn--primary" href="/">Strona główna</a>
        <a class="btn btn--ghost" href="/ile-kosztuje/">Cennik</a>
        <a class="btn btn--ghost" href="/kontakt/" data-umami-event="cta_click" data-umami-event-label="404: kontakt">Kontakt</a>
      </div>
    </div>
  </section>
</Base>
