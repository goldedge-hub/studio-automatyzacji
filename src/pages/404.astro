---
import Base from '../layouts/Base.astro';
---
<Base title="Nie ma takiej strony | Studio Automatyzacji" description="Strona nie istnieje." path="/404">
  <section class="section">
    <div class="wrap narrow" style="text-align:center">
      <p class="eyebrow">404</p>
      <h1>Tej strony nie ma</h1>
      <p class="lead">Adres mógł się zmienić albo jest literówka.</p>
      <div class="buttonrow" style="justify-content:center;margin-top:20px">
        <a class="btn btn--primary" href="/">Wróć na stronę główną</a>
        <a class="btn btn--ghost" href="/kontakt">Napisz do mnie</a>
      </div>
    </div>
  </section>
</Base>
