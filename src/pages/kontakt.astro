---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, CONTACT_RESPONSE, DIAGNOSIS_RESPONSE, FORM_ENDPOINT, mailtoHref } from '../config';
import { P } from '../data/pricing';

const hasEndpoint = Boolean(FORM_ENDPOINT);
const formAction = hasEndpoint ? FORM_ENDPOINT : mailtoHref('Zgłoszenie: mini-diagnoza e-mailem');
---
<Base
  title="Kontakt: opisz proces e-commerce"
  description="Opisz proces, który zabiera czas. Odpowiadamy w ciągu jednego dnia roboczego. Bezpłatna mini-diagnoza e-mailem w 2 dni robocze. NDA na życzenie."
  path="/kontakt"
>
  <section class="page-head">
    <div class="wrap">
      <div class="meta-line">
        <span>Kontakt</span>
        <span>Odpowiedź w ciągu {CONTACT_RESPONSE}</span>
        <span>Kontakt e-mailem</span>
      </div>
      <h1>Opisz proces, który zabiera czas</h1>
      <p class="lead">
        Wystarczy krótki opis. Odpowiemy z pytaniami albo od razu z informacją,
        czy wystarczy bezpłatna mini-diagnoza, czy potrzebny jest płatny audyt.
        Nie musisz mieć wszystkiego uporządkowanego.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <div>
          <form
            class="form"
            id="contact-form"
            action={formAction}
            method="post"
            enctype={hasEndpoint ? 'multipart/form-data' : 'text/plain'}
            data-endpoint={FORM_ENDPOINT}
            data-email={CONTACT_EMAIL}
            data-audit-label={`Audyt ${P.audit} netto`}
            aria-describedby="form-note"
          >
            <p class="small muted" style="margin:0">* pole wymagane</p>

            <div class="form-grid">
              <div class="field">
                <label for="f-name">Firma lub imię</label>
                <input
                  id="f-name"
                  name="name"
                  type="text"
                  autocomplete="organization"
                  placeholder="np. Sklep Meblex"
                />
              </div>

              <div class="field">
                <label for="f-email">E-mail <span class="req" aria-hidden="true">*</span></label>
                <input
                  id="f-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  aria-required="true"
                  placeholder="twoj@email.pl"
                />
              </div>

              <div class="field">
                <label for="f-tools">Używane narzędzia</label>
                <input
                  id="f-tools"
                  name="tools"
                  type="text"
                  autocomplete="off"
                  placeholder="Shoper, BaseLinker, Allegro, Excel, poczta"
                />
              </div>

              <div class="field">
                <label for="f-people">Ile osób to robi?</label>
                <select id="f-people" name="people">
                  <option value="">Nie wiem / wolę opisać</option>
                  <option value="1">1 osoba</option>
                  <option value="2-3">2–3 osoby</option>
                  <option value="4-10">4–10 osób</option>
                  <option value="10+">więcej niż 10 osób</option>
                </select>
              </div>

              <div class="field field--full">
                <label for="f-process">Proces, który zabiera czas <span class="req" aria-hidden="true">*</span></label>
                <textarea
                  id="f-process"
                  name="process"
                  rows="6"
                  required
                  aria-required="true"
                  aria-describedby="process-hint"
                  placeholder="Co robisz ręcznie, ile razy w tygodniu i ile to zajmuje? Np. codzienne przepisywanie zamówień z Allegro do BaseLinkera, około 40 minut."
                ></textarea>
                <p class="hint" id="process-hint">
                  Wystarczy jedno zdanie o procesie, wolumenie i tym, co się najczęściej psuje.
                  Resztę dopytamy.
                </p>
              </div>

              <div class="field field--full">
                <label for="f-topic">Temat (opcjonalnie)</label>
                <select id="f-topic" name="topic">
                  <option value="mini-diagnoza">Mini-diagnoza e-mailem (bezpłatnie)</option>
                  <option value="audyt">Audyt {P.audit} netto</option>
                  <option value="wdrozenie">Wdrożenie</option>
                  <option value="opieka">Opieka techniczna</option>
                  <option value="agencja">White-label dla agencji</option>
                  <option value="inne">Inne</option>
                </select>
              </div>
            </div>

            <label class="consent">
              <input type="checkbox" id="f-consent" name="consent" value="tak" required aria-required="true" />
              <span>
                Zgadzam się na kontakt w sprawie tego zgłoszenia. Dane przetwarzamy zgodnie z
                <a href="/polityka-prywatnosci">polityką prywatności</a>.
                Zasady pracy z danymi opisuje <a href="/zaufanie">Zaufanie i dane</a>.
              </span>
            </label>

            <div class="hp" aria-hidden="true">
              <label for="f-gotcha">Nie wypełniaj tego pola</label>
              <input id="f-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <button class="btn btn--primary" type="submit">
              {hasEndpoint ? 'Wyślij zgłoszenie' : 'Przygotuj wiadomość w mailu'}
            </button>

            <p class="form-note" id="form-note">
              {hasEndpoint ? (
                <>
                  Formularz wysyła zgłoszenie bezpośrednio. Jeśli coś nie zadziała, napisz na{' '}
                  <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
                </>
              ) : (
                <>
                  Formularz działa bez JavaScriptu: po wysłaniu spróbuje otworzyć Twój program pocztowy
                  z gotową wiadomością na <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
                  Jeśli okno się nie otworzy, napisz na ten sam adres.
                </>
              )}
            </p>

            <p class="form-status" id="form-status" role="status" aria-live="polite" tabindex="-1"></p>

            <noscript>
              <p class="form-note">
                Formularz nie wymaga JavaScriptu do walidacji pól. Po wysłaniu spróbuje otworzyć
                program pocztowy z gotową wiadomością. Jeśli tak się nie stanie, napisz
                bezpośrednio na
                <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
              </p>
            </noscript>
          </form>
        </div>

        <aside>
          <h2>Bezpośredni kontakt</h2>
          <p style="font-size:19px; line-height:1.4">
            <a class="text-link touch-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </p>
          <p class="small muted">
            Odpowiadamy w ciągu {CONTACT_RESPONSE}. Mini-diagnozę e-mailem wysyłamy
            w {DIAGNOSIS_RESPONSE}. Na życzenie podpisujemy NDA przed przekazaniem materiałów.
          </p>

          <h2 style="margin-top:30px">Co warto napisać</h2>
          <ul class="checklist">
            <li>Jaki proces chcesz zautomatyzować (jedno zdanie).</li>
            <li>Z jakich narzędzi korzystasz: Shoper, BaseLinker, Allegro, WooCommerce, Excel, poczta.</li>
            <li>Ile razy w tygodniu to robisz i ile to zajmuje.</li>
            <li>Ile osób wykonuje ten proces.</li>
          </ul>

          <div class="note" style="margin-top:26px">
            <strong>Nie musisz mieć wszystkiego uporządkowanego.</strong>
            Często pierwsza odpowiedź polega na ustaleniu, który proces w ogóle warto
            automatyzować. Jeśli żaden — też to napiszemy.
          </div>

          <p class="small muted" style="margin-top:22px">
            Nie używamy zewnętrznego kalendarza. Kontakt odbywa się e-mailem,
            w kolejności zgłoszeń.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;

    if (form) {
      const endpoint = form.dataset.endpoint || '';
      const email = form.dataset.email || '';
      const status = document.getElementById('form-status');
      const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const honeypot = document.getElementById('f-gotcha') as HTMLInputElement | null;
      const topic = document.getElementById('f-topic') as HTMLSelectElement | null;
      const auditLabel = form.dataset.auditLabel || 'Audyt';

      const setStatus = (message: string, state: 'success' | 'error' | '') => {
        if (!status) return;
        status.textContent = message;
        status.dataset.state = state;
      };

      const topicLabels: Record<string, string> = {
        'mini-diagnoza': 'Mini-diagnoza e-mailem',
        audyt: auditLabel,
        wdrozenie: 'Wdrożenie',
        opieka: 'Opieka techniczna',
        agencja: 'White-label dla agencji',
        inne: 'Inne',
      };

      const params = new URLSearchParams(window.location.search);
      const requestedTopic = params.get('temat');
      if (topic && requestedTopic && topicLabels[requestedTopic]) {
        topic.value = requestedTopic;
      }

      const buildMailto = (data: FormData, topicLabel: string) => {
        const name = String(data.get('name') || '').trim();
        const mail = String(data.get('email') || '').trim();
        const process = String(data.get('process') || '').trim();
        const tools = String(data.get('tools') || '').trim();
        const peopleValue = String(data.get('people') || '').trim();
        const peopleLabel = document.getElementById('f-people') as HTMLSelectElement | null;
        const people = peopleValue
          ? peopleLabel?.selectedOptions[0]?.textContent?.trim() || peopleValue
          : 'nie podano';
        const subject = `Zgłoszenie: ${topicLabel}${name ? ' / ' + name : ''}`;
        const body = [
          `Firma / imię: ${name || 'nie podano'}`,
          `E-mail: ${mail}`,
          `Temat: ${topicLabel}`,
          `Narzędzia: ${tools || 'nie podano'}`,
          `Liczba osób: ${people}`,
          '',
          'Proces, który zabiera czas:',
          process,
        ].join('\n');
        return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (honeypot?.value) {
          setStatus('Dziękujemy. Zgłoszenie zostało przyjęte.', 'success');
          return;
        }

        if (!form.checkValidity()) {
          form.reportValidity();
          setStatus('Uzupełnij wymagane pola: e-mail, opis procesu i zgodę na kontakt.', 'error');
          return;
        }

        const data = new FormData(form);
        const topicLabel = topicLabels[String(data.get('topic') || 'inne')] || 'Inne';

        if (!endpoint) {
          window.location.href = buildMailto(data, topicLabel);
          setStatus(
            `Otworzyliśmy program pocztowy z gotową wiadomością. Wyślij ją, a odpowiemy w ciągu jednego dnia roboczego. Jeśli okno się nie otworzyło, napisz na ${email}.`,
            'success',
          );
          return;
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Wysyłam…';
        }
        setStatus('Wysyłam zgłoszenie…', '');

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });

          if (!response.ok) throw new Error(`HTTP ${response.status}`);

          form.reset();
          setStatus(
            'Dziękujemy. Zgłoszenie zostało wysłane. Odpowiemy w ciągu jednego dnia roboczego, a mini-diagnozę wyślemy w ciągu 2 dni roboczych.',
            'success',
          );
          if (submit) submit.textContent = 'Wysłano';
        } catch {
          setStatus(
            `Nie udało się wysłać formularza. Napisz bezpośrednio na ${email} — adres jest też w stopce i w sekcji kontaktu.`,
            'error',
          );
          if (submit) {
            submit.disabled = false;
            submit.textContent = 'Wyślij zgłoszenie';
          }
          status?.focus();
        }
      });
    }
  </script>
</Base>
