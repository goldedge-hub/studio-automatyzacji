---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, CONTACT_RESPONSE, DIAGNOSIS_RESPONSE, FORM_ENDPOINT } from '../config';
import { P } from '../data/pricing';

const sourcePath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<Base
  title="Kontakt: opisz proces e-commerce"
  description="Opisz proces, który zabiera czas. Odpowiadamy w ciągu jednego dnia roboczego. Bezpłatna mini-diagnoza e-mailem w 2 dni robocze. NDA na życzenie."
  path="/kontakt"
>
  <section class="page-head">
    <div class="wrap">
      <div class="meta-line">
        <span>Kontakt</span>
        <span>Czas odpowiedzi: {CONTACT_RESPONSE}</span>
        <span>Formularz i e-mail</span>
      </div>
      <h1>Opisz proces, który zabiera czas</h1>
      <p class="lead">
        Wystarczy krótki opis. Odpowiemy z pytaniami albo od razu z informacją,
        czy wystarczy bezpłatna mini-diagnoza, czy potrzebny jest płatny audyt.
        Nie musisz mieć wszystkiego uporządkowanego.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <div>
          <p
            class="form-status"
            id="form-status"
            role="alert"
            aria-live="assertive"
            tabindex="-1"
            data-email={CONTACT_EMAIL}
          ></p>

          <form
            class="form"
            id="contact-form"
            action={FORM_ENDPOINT}
            method="post"
            data-email={CONTACT_EMAIL}
            aria-describedby="form-note"
          >
            <p class="small muted" style="margin:0">* pole wymagane</p>

            <div class="form-grid">
              <div class="field">
                <label for="f-name">Firma lub imię</label>
                <input
                  id="f-name"
                  name="name"
                  type="text"
                  maxlength="120"
                  autocomplete="organization"
                  placeholder="np. Sklep Meblex"
                />
              </div>

              <div class="field">
                <label for="f-email">E-mail <span class="req" aria-hidden="true">*</span></label>
                <input
                  id="f-email"
                  name="email"
                  type="email"
                  maxlength="200"
                  autocomplete="email"
                  required
                  aria-required="true"
                  placeholder="twoj@email.pl"
                />
              </div>

              <div class="field">
                <label for="f-tools">Używane narzędzia</label>
                <input
                  id="f-tools"
                  name="tools"
                  type="text"
                  maxlength="300"
                  autocomplete="off"
                  placeholder="Shoper, BaseLinker, Allegro, Excel, poczta"
                />
              </div>

              <div class="field">
                <label for="f-people">Ile osób to robi?</label>
                <select id="f-people" name="people">
                  <option value="">Nie wiem / wolę opisać</option>
                  <option value="1">1 osoba</option>
                  <option value="2-3">2–3 osoby</option>
                  <option value="4-10">4–10 osób</option>
                  <option value="10+">więcej niż 10 osób</option>
                </select>
              </div>

              <div class="field field--full">
                <label for="f-process">Proces, który zabiera czas <span class="req" aria-hidden="true">*</span></label>
                <textarea
                  id="f-process"
                  name="process"
                  rows="6"
                  maxlength="4000"
                  required
                  aria-required="true"
                  aria-describedby="process-hint"
                  placeholder="Co robisz ręcznie, ile razy w tygodniu i ile to zajmuje? Np. codzienne przepisywanie zamówień z Allegro do BaseLinkera, około 40 minut."
                ></textarea>
                <p class="hint" id="process-hint">
                  Wystarczy jedno zdanie o procesie, wolumenie i tym, co się najczęściej psuje.
                  Resztę dopytamy.
                </p>
              </div>

              <div class="field field--full">
                <label for="f-topic">Temat (opcjonalnie)</label>
                <select id="f-topic" name="topic">
                  <option value="mini-diagnoza">Mini-diagnoza e-mailem (bezpłatnie)</option>
                  <option value="audyt">Audyt {P.audit} netto</option>
                  <option value="wdrozenie">Wdrożenie</option>
                  <option value="opieka">Opieka techniczna</option>
                  <option value="agencja">White-label dla agencji</option>
                  <option value="inne">Inne</option>
                </select>
              </div>
            </div>

            <label class="consent">
              <input type="checkbox" id="f-consent" name="consent" value="tak" required aria-required="true" />
              <span>
                Zgadzam się na przetwarzanie podanych danych w celu odpowiedzi na to zgłoszenie.
                Administratorem danych jest Studio Automatyzacji; szczegóły w
                <a href="/polityka-prywatnosci">polityce prywatności</a>.
              </span>
            </label>

            <div class="hp" aria-hidden="true">
              <label for="f-website">Nie wypełniaj tego pola</label>
              <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <input type="hidden" name="source" value={sourcePath} />
            <input type="hidden" name="ts" id="f-ts" value="" />

            <button class="btn btn--primary" type="submit" data-umami-event="form_submit">
              Wyślij zgłoszenie
            </button>

            <p class="form-note" id="form-note">
              Po wysłaniu dostaniesz automatyczne potwierdzenie e-mailem. Odpowiadamy
              w ciągu {CONTACT_RESPONSE}.
            </p>
          </form>
        </div>

        <aside>
          <h2>Bezpośredni kontakt</h2>
          <p style="font-size:19px; line-height:1.4">
            <a class="text-link touch-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </p>
          <p class="small muted">
            Czas odpowiedzi: {CONTACT_RESPONSE}. Mini-diagnozę e-mailem wysyłamy
            w {DIAGNOSIS_RESPONSE}. Na życzenie podpisujemy NDA przed przekazaniem materiałów.
          </p>

          <h2 style="margin-top:30px">Co warto napisać</h2>
          <ul class="checklist">
            <li>Jaki proces chcesz zautomatyzować (jedno zdanie).</li>
            <li>Z jakich narzędzi korzystasz: Shoper, BaseLinker, Allegro, WooCommerce, Excel, poczta.</li>
            <li>Ile razy w tygodniu to robisz i ile to zajmuje.</li>
            <li>Ile osób wykonuje ten proces.</li>
          </ul>

          <div class="note" style="margin-top:26px">
            <strong>Nie musisz mieć wszystkiego uporządkowanego.</strong>
            Często pierwsza odpowiedź polega na ustaleniu, który proces w ogóle warto
            automatyzować. Jeśli żaden — też to napiszemy.
          </div>

          <p class="small muted" style="margin-top:22px">
            Nie używamy zewnętrznego kalendarza. Kontakt odbywa się e-mailem,
            w kolejności zgłoszeń.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('contact-form');
      const topic = document.getElementById('f-topic');
      const status = document.getElementById('form-status');
      const timestamp = document.getElementById('f-ts');
      const params = new URLSearchParams(window.location.search);

      // Znacznik czasu dla serwera: odrzuca wysyłki szybsze niż 3 s.
      // Bez JavaScriptu pole zostaje puste i serwer to akceptuje.
      if (timestamp) timestamp.value = String(Date.now());

      // Preselekcja tematu: /kontakt?temat=audyt itd.
      const requestedTopic = params.get('temat');
      if (topic && requestedTopic) {
        const known = Array.prototype.some.call(
          topic.options,
          (option) => option.value === requestedTopic,
        );
        if (known) topic.value = requestedTopic;
      }

      // Komunikaty po powrocie z serwera: /kontakt?blad=1|limit|walidacja
      const code = params.get('blad');
      if (!status || !code) return;

      const messages = {
        '1': 'Nie udało się wysłać. Napisz bezpośrednio na ',
        limit: 'Za dużo zgłoszeń z tego adresu, spróbuj za godzinę',
        walidacja: 'Uzupełnij e-mail, opis procesu i zgodę',
      };

      const message =
        code === '1' || code === 'limit' || code === 'walidacja' ? messages[code] : '';
      if (!message) return;

      status.dataset.state = 'error';
      status.textContent = message;

      if (code === '1') {
        const email = form?.dataset.email || status.dataset.email || '';
        if (email) {
          const link = document.createElement('a');
          link.className = 'text-link';
          link.href = 'mailto:' + email;
          link.textContent = email;
          status.appendChild(link);
        }
      }
    })();
  </script>
</Base>
