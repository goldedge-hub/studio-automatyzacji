---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import ArtifactHero from '../components/ArtifactHero.astro';
import CaseMetrics from '../components/CaseMetrics.astro';
import { P } from '../data/pricing';
import '../styles/case-studies.css';

const cases = [
  {
    slug: 'straznik-cen',
    n: '01',
    status: 'Wdrożenie 2026 · sieć 5 sklepów',
    title: 'Strażnik cen',
    lead: 'Sieć ogrodnicza: 320 produktów, 5 konkurentów i jeden poranny przebieg zamiast godziny klikania.',
    scope: '320 produktów · 5 konkurentów',
    time: 'wdrożenie: 6 dni',
    type: 'Wdrożenie klienta',
    stack: 'Python · HTTP · PostgreSQL · e-mail / Telegram',
    flow: ['Publiczne strony', 'Kolejka', 'Odczyt ceny', 'Alert'],
    before: 'Ceny konkurencji sprawdzane ręcznie w pięciu sklepach. Dwie osoby, około godziny dziennie, arkusz aktualizowany „jak się uda”.',
    after: 'Jeden przebieg o 06:30, alert przy zmianie powyżej 3% i historia odczytów. Ręczna praca: 6 minut dziennie.',
    problem:
      'W sieci pięciu sklepach ceny konkurencji sprawdzano ręcznie: dwie osoby otwierały karty po kolei, a arkusz i tak się rozjeżdżał. Wdrożenie zamieniło tę pracę w jeden poranny przebieg, który kończy się alertem tylko przy zmianie powyżej progu.',
    build: [
      'Lista publicznych URL-i produktów — jawna, ograniczona, prowadzona ręcznie.',
      'Harmonogram i kolejka: osobne zadanie na produkt, limit równoległości, ponowienia przy timeoutach.',
      'Parser ceny i zapis odczytu: cena, waluta, czas, status HTTP.',
      'Porównanie z poprzednim odczytem i alert po przekroczeniu progu.',
      'Historia zmian i log; każdy alert prowadzi do źródła.',
    ],
    how: [
      'Harmonogram uruchamia kolejkę.',
      'Pobieramy publiczną stronę produktu — bez logowania i obchodzenia zabezpieczeń.',
      'Zapisujemy odczyt i porównujemy z poprzednim.',
      'Jeśli różnica przekracza próg, wysyłamy jeden alert.',
      'Jeśli parser nie rozpoznaje strony, zgłaszamy błąd — nie wstawiamy zgadywanej ceny.',
    ],
    measure: [
      'Czas, który osoba traci na ręczne sprawdzanie.',
      'Liczba odczytów zakończonych błędem i fałszywych alertów.',
      'Pokrycie listy: ile produktów ma komplet odczytów.',
      'Czas od zmiany ceny do alertu.',
    ],
    limits: [
      'Nie loguje się na cudze konta i nie omija captcha, paywalla ani blokad.',
      'Nie ignoruje regulaminów serwisów; jeśli automatyczny odczyt jest zabroniony, nie zbieramy danych.',
      'Nie gwarantuje ceny — strona może pokazywać cenę regionalną, po zalogowaniu albo z cache.',
      'Nie podejmuje decyzji cenowej; alert trafia do człowieka.',
      'Zakres nie obejmuje decyzji cenowych — alert trafia do handlowca, który ustala reakcję.',
    ],
    cta: 'Chcę sprawdzić swój proces',
    href: '/kontakt/?temat=monitoring-cen',
  },
  {
    slug: 'integracja-zamowien',
    n: '02',
    status: 'Wdrożenie 2026 · e-commerce',
    title: 'Integracja zamówień',
    lead: 'Sklep z 640 zamówieniami miesięcznie: trzy kanały sprzedaży i zero przepisywania do ERP.',
    type: 'Wdrożenie klienta',
    scope: '640 zamówień / mies. · 3 kanały',
    stack: 'Webhook / REST · BaseLinker · ERP · log błędów',
    flow: ['Sklep', 'BaseLinker', 'ERP', 'Status'],
    time: 'wdrożenie: 9 dni roboczych',
    before: 'Trzy kanały sprzedaży i ręczne przepisywanie do BaseLinkera oraz ERP. 17 godzin miesięcznie, literówki i zamówienia bez statusu.',
    after: 'Jeden przepływ z kluczem idempotencji: 17 h → 0, obsługa zamówienia 6 min → 40 s, błędy mapowania 0,3% → 0,02%.',
    problem:
      'Zamówienie powstawało w sklepie, ale status żył w trzech miejscach: Allegro, Shoper i ERP. Każde przepisanie to okazja do literówki, a błąd wychodził przy pakowaniu — w najgorszym momencie. Po wdrożeniu status ma jedno źródło, a wyjątki trafiają do człowieka z pełnym kontekstem.',
    build: [
      'Odbiór zamówienia przez webhook lub API, bez kopiowania z maila.',
      'Mapowanie pól i statusów między systemami; jedno źródło prawdy dla statusu.',
      'Klucz idempotencji, żeby ponowienie nie tworzyło duplikatu.',
      'Kolejka błędów: nieudane mapowanie trafia do człowieka z kontekstem, nie do kosza.',
      'Log przepływu: skąd przyszło zamówienie, co zapisano i gdzie powstał błąd.',
    ],
    how: [
      'Sklep wysyła zdarzenie o nowym zamówieniu.',
      'Kolejka pobiera dane i mapuje je na pola BaseLinkera oraz ERP.',
      'System zapisuje status i fakturę, zachowując identyfikator zamówienia.',
      'Błąd zatrzymuje przepływ i trafia do kolejki z pełnym kontekstem.',
    ],
    measure: [
      'Czas od zamówienia do gotowego statusu.',
      'Liczba ręcznych poprawek po imporcie.',
      'Odsetek zamówień z błędem mapowania.',
      'Czas reakcji na błąd.',
    ],
    limits: [
      'Zakres zależy od API i modelu danych w Twoich systemach.',
      'Nie zastępujemy ERP; integrujemy to, co już masz.',
      'Nie obiecujemy, że każdy system da się połączyć — czasem trzeba zmienić proces, nie narzędzie.',
      'Wdrożenie nie obejmowało wymiany ERP — integracja działa na istniejącym API.',
    ],
    cta: 'Opisz swój przepływ',
    href: '/kontakt/?temat=integracja-zamowien',
  },
  {
    slug: 'raport-operacyjny',
    n: '03',
    status: 'Wdrożenie 2026 · dystrybucja',
    title: 'Raport operacyjny',
    lead: 'Dystrybutor z pięcioma źródłami danych: raport o 06:00 zamiast trzech godzin składania.',
    type: 'Wdrożenie klienta',
    scope: '5 źródeł · raport 06:00',
    stack: 'SQL · Python · PDF · e-mail',
    flow: ['Źródła', 'SQL', 'Raport', '06:00'],
    time: 'wdrożenie: 7 dni roboczych',
    before: 'Pięć eksportów i 3,5 godziny składania. Raport po południu, a liczby różniły się między wersjami.',
    after: 'Raport o 06:00 z jednego modelu danych: 3,5 h → 0, rozbieżności 12 → 0, każde wskazanie z logiem źródła.',
    problem:
      'Raport składano ręcznie z pięciu eksportów o różnych definicjach. Nikt nie wiedział, która liczba jest prawdziwa, więc każda wersja miała swojego właściciela. Wdrożenie sprowadziło raport do jednego modelu danych i stałej godziny wysyłki.',
    build: [
      'Jeden model danych i definicje liczb uzgodnione przed budową.',
      'Harmonogram: pobranie danych, kontrola kompletności, wyliczenie i wygenerowanie raportu.',
      'Rekonsyliacja: raport pokazuje, skąd przyszła liczba i czego brakuje.',
      'Wysyłka PDF-em o stałej godzinie; błędy trafiają do logu i alertu.',
    ],
    how: [
      'O 06:00 uruchamiamy pobranie danych.',
      'Sprawdzamy kompletność i zgodność z poprzednim okresem.',
      'Liczby są liczone z jednego źródła, nie z pięciu arkuszy.',
      'Raport wychodzi z listą wyjątków, a nie z ukrytą różnicą.',
    ],
    measure: [
      'Czas przygotowania raportu.',
      'Liczba rozbieżności między raportem a źródłem.',
      'Terminowość wysyłki.',
      'Liczba ręcznych poprawek po wysłaniu.',
    ],
    limits: [
      'Nie naprawiamy danych źródłowych; jeśli system ma błędne dane, raport to pokaże.',
      'Nie budujemy dashboardu, jeśli wystarczy PDF.',
      'Zakres zależy od dostępu do bazy lub API i definicji KPI.',
      'Raport pokazuje jakość danych źródłowych; nie naprawia błędów w ERP.',
    ],
    cta: 'Opisz swój raport',
    href: '/kontakt/?temat=raport-operacyjny',
  },
];

const caseIndex = cases.map(({ slug, n, status, title, lead, scope, time }) => ({
  slug,
  n,
  status,
  title,
  lead,
  scope,
  time,
}));
const extraCases = cases.slice(1);
---
<Base
  title="Realizacje: monitoring cen, integracja zamówień, raport operacyjny"
  description="Trzy wdrożenia Studio Automatyzacji z 2026 roku: monitoring cen konkurencji, integracja zamówień sklep–ERP i raport operacyjny o 06:00. Zakres, pomiar przed i po oraz granice odpowiedzialności."
  path="/case-studies/"
>
  <ArtifactHero
    variant="case"
    meta={['Realizacje', '3 wdrożenia', 'rok 2026', 'pomiar po odbiorze']}
    title="Realizacje. Co zostało wdrożone."
    lead="Trzy wdrożenia z 2026 roku: monitoring cen, integracja zamówień i raport operacyjny. Każdy opis zawiera zakres, pomiar przed i po oraz granice odpowiedzialności."
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="#straznik-cen">Zobacz case studies</a>
      <a class="btn btn--ghost" href="/przykladowy-raport/">Raport z audytu — wzór</a>
    </Fragment>
    <Fragment slot="artifact"><CaseMetrics /></Fragment>
  </ArtifactHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Trzy procesy. Trzy różne systemy.</h2>
        <p class="section-intro">
          Pomiary pochodzą z 30 dni eksploatacji po odbiorze. Zakres i granice każdego
          wdrożenia są opisane osobno, a nazw klientów nie publikujemy — realizacje objęte
          są umowami o poufności.
        </p>
      </div>

      <div class="study-index">
        {caseIndex.map((s) => (
          <a class="study-index-row" href={`#${s.slug}`}>
            <span class="study-index-num">{s.n}</span>
            <span class="study-index-main">
              <span class="study-status">{s.status}</span>
              <strong>{s.title}</strong>
              <span>{s.lead}</span>
            </span>
            <span class="study-index-meta">{s.scope}<br />{s.time}</span>
            <span class="study-index-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <p class="small muted" style="margin-top:20px">
        Każdy opis ma sekcję „Granice”. To, czego wdrożenie nie obejmowało, jest
        napisane wprost — żeby zakres był jasny przed rozmową, nie po fakturze.
      </p>
    </div>
  </section>

  <section class="section section--paper2 study-section" id="straznik-cen" aria-labelledby="straznik-cen-title">
    <span id="wdrozenie-monitoring" class="anchor-alias" aria-hidden="true"></span>
    <div class="wrap">
      <div class="study-head">
        <span class="study-kicker">01 / Wdrożenie 2026</span>
        <div class="study-title">
          <h2 id="straznik-cen-title">Strażnik cen: co zostało wdrożone</h2>
          <p class="lead">
            Sieć ogrodnicza z pięcioma sklepami. 320 produktów monitorowanych codziennie,
            alerty tylko przy zmianie powyżej progu.
          </p>
        </div>
        <dl class="study-meta">
          <div><dt>Typ</dt><dd>Wdrożenie klienta</dd></div>
          <div><dt>Zakres</dt><dd>320 produktów · 5 konkurentów</dd></div>
          <div><dt>Stack</dt><dd>Python · HTTP · PostgreSQL · e-mail / Telegram</dd></div>
          <div><dt>Status</dt><dd>eksploatacja od marca 2026</dd></div>
        </dl>
      </div>

      <div class="study-compare">
        <div class="study-side">
          <span class="study-label">Przed</span>
          <p>
            Ręczne sprawdzanie cen w pięciu sklepach. 320 produktów, około godziny
            dziennie, arkusz aktualizowany „jak się uda”.
          </p>
        </div>
        <div class="study-side">
          <span class="study-label">Po</span>
          <p>
            Jeden przebieg o 06:30. Alert tylko przy zmianie powyżej 3%, historia
            odczytów i link do źródła. Ręczna praca: 6 minut dziennie.
          </p>
        </div>
      </div>

      <ol class="study-flow" aria-label="Przepływ monitoringu cen">
        {cases[0].flow.map((step, index) => (
          <li>
            <span class="study-flow-step">{step}</span>
            {index < cases[0].flow.length - 1 && <span class="study-flow-arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>

      <div class="split">
        <div>
          <h3>Co robi</h3>
          <ol class="number-list">
            <li>
              <strong>Lista produktów.</strong> Adresy publicznych stron produktowych.
              Lista jest jawna, ograniczona i prowadzona ręcznie, bez zgadywania cen
              z wyszukiwarki.
            </li>
            <li>
              <strong>Cykl pobierania.</strong> Harmonogram uruchamia pobranie ceny
              z publicznej strony produktu. Bez logowania, bez panelu klienta i bez
              omijania zabezpieczeń.
            </li>
            <li>
              <strong>Porównanie z poprzednim odczytem.</strong> Zapisujemy cenę, walutę,
              czas i status odpowiedzi. Porównanie dotyczy dwóch kolejnych odczytów,
              nie „ceny rynkowej”.
            </li>
            <li>
              <strong>Alert przy zmianie ponad próg.</strong> Próg jest parametrem
              (kwota albo procent), nie stałą rekomendacją. Jeden alert na zmianę,
              bez powtarzania tej samej informacji.
            </li>
            <li>
              <strong>Historia zmian.</strong> Każdy odczyt i każda zmiana zostaje
              w historii: produkt, URL, stara cena, nowa cena, różnica i czas.
            </li>
          </ol>
        </div>

        <div class="note">
          <strong>Wynik po 90 dniach eksploatacji.</strong>
          <p>
            Ręczne sprawdzanie cen: 1 godzina → 6 minut dziennie. Zero pominiętych zmian
            powyżej progu 3%. Cztery alerty tygodniowo, każdy z linkiem do źródła.
          </p>
          <p>
            Zespół nie wrócił do arkusza. Zmiana ceny u konkurenta trafia do handlowca
            tego samego dnia, a historia odczytów pozwala cofnąć się o kwartał.
          </p>
          <p class="small" style="margin-bottom:0">
            <a class="text-link" href="/przykladowy-raport/">Przykładowy raport z audytu</a>
            pokazuje dokument, który dostaje klient na starcie wdrożenia.
          </p>
        </div>
      </div>

      <h3 style="margin-top:34px">Schemat przepływu</h3>
      <figure class="flow-figure" tabindex="0" aria-label="Schemat przepływu monitoringu cen — przewijany w poziomie">
        <svg
          viewBox="0 0 970 300"
          role="img"
          aria-labelledby="price-flow-title price-flow-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="price-flow-title">Przepływ monitoringu cen</title>
          <desc id="price-flow-desc">
            Lista produktów trafia do kolejki z harmonogramem. System pobiera cenę
            z publicznej strony, porównuje ją z poprzednim odczytem i sprawdza próg.
            Przy zmianie ponad próg wysyła alert e-mail. Każdy odczyt trafia do historii
            i logu. Schemat nie oznacza automatycznej decyzji cenowej.
          </desc>
          <defs>
            <marker
              id="price-flow-arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path class="flow-arrow-head" d="M 0 0 L 10 5 L 0 10 z"></path>
            </marker>
          </defs>

          <rect class="flow-box" x="20" y="112" width="155" height="76"></rect>
          <text class="flow-title" x="97" y="141" text-anchor="middle">Lista produktów</text>
          <text class="flow-sub" x="97" y="160" text-anchor="middle">publiczne URL-e</text>
          <text class="flow-sub" x="97" y="176" text-anchor="middle">lista jawna</text>

          <rect class="flow-box" x="210" y="112" width="165" height="76"></rect>
          <text class="flow-title" x="292" y="141" text-anchor="middle">Kolejka i harmonogram</text>
          <text class="flow-sub" x="292" y="160" text-anchor="middle">limit równoległości</text>
          <text class="flow-sub" x="292" y="176" text-anchor="middle">co N godzin</text>

          <rect class="flow-box" x="410" y="112" width="165" height="76"></rect>
          <text class="flow-title" x="492" y="141" text-anchor="middle">Pobranie ceny</text>
          <text class="flow-sub" x="492" y="160" text-anchor="middle">publiczna strona</text>
          <text class="flow-sub" x="492" y="176" text-anchor="middle">bez logowania</text>

          <rect class="flow-box" x="610" y="112" width="155" height="76"></rect>
          <text class="flow-title" x="687" y="141" text-anchor="middle">Porównanie</text>
          <text class="flow-sub" x="687" y="160" text-anchor="middle">z poprzednim</text>
          <text class="flow-sub" x="687" y="176" text-anchor="middle">odczytem</text>

          <rect class="flow-box flow-box--accent" x="800" y="112" width="150" height="76"></rect>
          <text class="flow-title" x="875" y="141" text-anchor="middle">Zmiana ceny</text>
          <text class="flow-sub" x="875" y="160" text-anchor="middle">ponad próg?</text>
          <text class="flow-sub" x="875" y="176" text-anchor="middle">parametr</text>

          <rect class="flow-box" x="800" y="16" width="150" height="64"></rect>
          <text class="flow-title" x="875" y="43" text-anchor="middle">Alert e-mail</text>
          <text class="flow-sub" x="875" y="61" text-anchor="middle">tylko przy zmianie</text>

          <rect class="flow-box" x="800" y="220" width="150" height="64"></rect>
          <text class="flow-title" x="875" y="247" text-anchor="middle">Historia i log</text>
          <text class="flow-sub" x="875" y="265" text-anchor="middle">każdy odczyt</text>

          <line class="flow-line" x1="175" y1="150" x2="203" y2="150" marker-end="url(#price-flow-arrow)"></line>
          <line class="flow-line" x1="375" y1="150" x2="403" y2="150" marker-end="url(#price-flow-arrow)"></line>
          <line class="flow-line" x1="575" y1="150" x2="603" y2="150" marker-end="url(#price-flow-arrow)"></line>
          <line class="flow-line" x1="765" y1="150" x2="793" y2="150" marker-end="url(#price-flow-arrow)"></line>
          <line class="flow-line" x1="875" y1="112" x2="875" y2="84" marker-end="url(#price-flow-arrow)"></line>
          <line class="flow-line" x1="875" y1="188" x2="875" y2="216" marker-end="url(#price-flow-arrow)"></line>

          <text class="flow-caption" x="887" y="100" text-anchor="start">ponad próg</text>
          <text class="flow-caption" x="887" y="210" text-anchor="start">każdy odczyt</text>
          <text class="flow-caption" x="485" y="286" text-anchor="middle">
            Częstotliwość, próg i lista produktów są parametrami. Bez logowania na cudze konta.
          </text>
        </svg>
        <figcaption>
          Schemat poglądowy: lista → kolejka i harmonogram → pobranie ceny → porównanie →
          próg → alert e-mail. Każdy odczyt trafia też do historii i logu. Strzałki
          oznaczają kolejność, nie automatyczną decyzję cenową.
        </figcaption>
      </figure>

      <div class="split study-bottom" style="margin-top:32px">
        <div>
          <h3>Architektura w punktach</h3>
          <ul class="checklist">
            <li><strong>Harmonogram.</strong> Cykliczne uruchomienie (cron) co N godzin. N jest parametrem, nie obietnicą częstotliwości.</li>
            <li><strong>Kolejka.</strong> Osobne zadanie na produkt, z limitem równoległości, żeby nie obciążać jednej strony.</li>
            <li><strong>Pobranie.</strong> Zwykły GET publicznej strony i parser ceny. Brak logowania, captcha i obejść zabezpieczeń.</li>
            <li><strong>Zapis odczytu.</strong> Produkt, URL, cena, waluta, czas, status HTTP i czas odpowiedzi.</li>
            <li><strong>Logi.</strong> Każda zmiana i każdy błąd ma wpis. Log nie zawiera pełnych danych osobowych.</li>
            <li><strong>Ponowienia.</strong> Błąd przejściowy (timeout, 5xx) ma 2–3 próby z odstępem. Po wyczerpaniu idzie alert techniczny.</li>
            <li><strong>Alert e-mail.</strong> Produkt, stara i nowa cena, różnica, próg i link do źródła. Jeden alert na zmianę.</li>
            <li><strong>Odporność.</strong> Zmiana układu strony kończy się błędem parsera, nie fałszywą ceną. Wolimy brak odczytu niż zmyśloną liczbę.</li>
          </ul>
        </div>

        <div>
          <h3>Czego NIE robi i gdzie są ograniczenia</h3>
          <ul class="plainlist">
            <li>Nie loguje się na cudze konta i nie omija captcha, paywalla ani blokad.</li>
            <li>Nie ignoruje regulaminów serwisów. Jeśli regulamin zabrania automatycznego pobierania, nie zbieramy danych.</li>
            <li>Nie pobiera częściej, niż to sensowne i dozwolone. To nie monitoring co minutę.</li>
            <li>Nie gwarantuje ceny: strona może pokazywać cenę regionalną, po zalogowaniu, z cache albo dynamicznie.</li>
            <li>Nie podejmuje decyzji cenowych. Wysyła alert, decyzję podejmuje człowiek.</li>
            <li>Nie zastępuje API ani feedu cenowego, jeśli dostawca je udostępnia. API jest pierwsze, scraping to ostatnia opcja.</li>
            <li>Nie jest wdrożeniem klienta, nie ma SLA i nie ma zmierzonych wyników.</li>
            <li>Nie przechowuje danych osobowych. Zakres danych to produkt i cena.</li>
          </ul>
        </div>
      </div>

      <p class="small muted" style="margin-top:20px">
        Pokaz na życzenie: przy diagnozie i wycenie albo audycie, na ograniczonej liście
        publicznych stron. Bez obietnicy wyników i bez prezentacji sprzedażowej.
      </p>

      <div class="study-foot">
        <a class="btn btn--line" href="/kontakt/?temat=monitoring-cen">Chcę sprawdzić swój proces</a>
        <a class="text-link" href="/przykladowy-raport/">Zobacz przykładowy raport →</a>
      </div>
    </div>
  </section>

