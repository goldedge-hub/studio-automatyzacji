---
import Base from '../layouts/Base.astro';
import ContactLink from '../components/ContactLink.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Calculator from '../components/Calculator.astro';
import Scenario from '../components/Scenario.astro';
import { PRICE_UPDATED } from '../config';
import { P } from '../data/pricing';
import { pricingFaq } from '../data/faq';
import { notWorth } from '../data/content';

const prices = [
  {
    service: 'Mini-diagnoza e-mailem',
    price: P.miniDiagnosis,
    includes: 'Krótka pisemna ocena jednego procesu: czy warto automatyzować, szacunek godzin [EST], narzędzia. Bez pełnego raportu i bez wyceny z gwarancją.',
    term: 'Odpowiedź w 2 dni robocze',
  },
  {
    service: 'Audyt automatyzacji',
    price: `${P.audit} netto`,
    includes: 'Mapa procesu, koszt ręcznej pracy, priorytety, ryzyka i wycena wdrożenia. Odliczany od wdrożenia.',
    term: 'Raport orientacyjnie w 3 dni robocze',
  },
  {
    service: 'Wdrożenie Start',
    price: `${P.start} netto`,
    includes: '1 proces, do 3 integracji, testy na danych klienta, dokumentacja, szkolenie, 30 dni gwarancji.',
    term: 'Orientacyjnie 5–10 dni roboczych',
  },
  {
    service: 'Wdrożenie Growth',
    price: `${P.growth} netto`,
    includes: '3 procesy, dashboard lub raport cykliczny, do 6 integracji, alerty i obsługa błędów, 60 dni gwarancji.',
    term: 'Orientacyjnie 3 tygodnie',
  },
  {
    service: 'Wdrożenie Scale',
    price: `${P.scaleFrom} netto`,
    includes: 'Od 4 procesów, integracje ERP / WMS, wdrożenie etapami, SLA w umowie, opieka po odbiorze.',
    term: 'Orientacyjnie 4–6 tygodni',
  },
  {
    service: 'Opieka techniczna',
    price: `${P.care} netto/mc`,
    includes: 'Monitoring, alerty i kopie, do 5 h zmian miesięcznie, SLA reakcji 1 dzień roboczy, przegląd kwartalny i 1 h konsultacji/mc.',
    term: 'Rozliczenie miesięczne, wypowiedzenie 1 mc',
  },
  {
    service: 'White-label dla agencji',
    price: `${P.whiteLabel} netto/proces`,
    includes: 'Jeden proces do 3 integracji, pod marką agencji, bez kontaktu z klientem końcowym, NDA na życzenie. Przy trzech procesach lub więcej stawka wynosi ' + P.whiteLabel3plus + ' netto za proces.',
    term: 'Orientacyjnie 5–7 dni roboczych',
  },
];

const comparison = [
  ['Liczba procesów', '1', '3', 'od 4'],
  ['Integracje', 'do 3', 'do 6', 'ERP / WMS, wiele systemów'],
  ['Raport lub dashboard', 'opcjonalnie', 'w cenie', 'wg zakresu'],
  ['Testy na danych klienta', 'tak', 'tak', 'tak'],
  ['Dokumentacja', 'tak', 'tak', 'tak, techniczna'],
  ['Szkolenie', 'tak', 'tak', 'wg potrzeb'],
  ['Gwarancja', '30 dni', '60 dni', 'wg umowy'],
  ['Monitoring i alerty', 'opcjonalnie', 'w cenie', 'w cenie'],
  ['Opieka', `${P.care}/mc`, `${P.care}/mc`, 'wg umowy'],
  ['Cena netto', P.start, P.growth, P.scaleFrom],
];

const careRows = [
  ['Monitoring, alerty i kopie', 'tak'],
  ['Drobne zmiany', 'do 5 h/mc'],
  ['SLA reakcji', '1 dzień roboczy'],
  ['Przegląd', 'kwartalny + 1 h konsultacji/mc'],
  ['Zobowiązanie', 'miesięczne, wypowiedzenie 1 mc'],
];

const costDrivers = [
  {
    t: 'Liczba procesów',
    d: 'Każdy proces ma osobne wejście, wyjątki i kryterium odbioru. Jeden dobrze opisany proces jest tańszy niż trzy połączone.',
  },
  {
    t: 'Integracje i API',
    d: 'System z dokumentacją i testowym środowiskiem jest prostszy niż panel bez API. Rate limity i autoryzacja też wpływają na zakres.',
  },
  {
    t: 'Jakość danych',
    d: 'Duplikaty, brak identyfikatorów i ręczne poprawki wymagają dodatkowej logiki. Czasem najpierw trzeba uporządkować źródło.',
  },
  {
    t: 'Wyjątki',
    d: 'Im więcej decyzji człowieka przy pojedynczym rekordzie, tym więcej reguł i testów. Wyjątki można zostawić człowiekowi, ale trzeba je opisać.',
  },
  {
    t: 'Środowisko',
    d: 'Chmura, serwer klienta i dostępność sieci zmieniają sposób wdrożenia. Na początku ustalamy, gdzie ma działać proces.',
  },
  {
    t: 'Utrzymanie',
    d: 'Monitoring, alerty i reakcja na zmiany w API to osobna praca. Można ją zostawić po stronie klienta albo objąć opieką techniczną.',
  },
];
---
<Base
  title="Cennik automatyzacji: audyt, wdrożenia, opieka"
  description={`Jawne ceny netto: mini-diagnoza ${P.miniDiagnosis}, audyt ${P.audit} odliczany od wdrożenia, Start ${P.start}, Growth ${P.growth}, Scale ${P.scaleFrom}, opieka ${P.care}/mc.`}
  path="/ile-kosztuje"
  faq={pricingFaq}
>
  <section class="page-head">
    <div class="wrap">
      <div class="meta-line">
        <span>Cennik netto</span>
        <span>Aktualizacja: {PRICE_UPDATED}</span>
        <span>Oferta aktualna</span>
      </div>
      <h1>Ile kosztuje automatyzacja</h1>
      <p class="lead">
        Ceny są stałe przed startem. Poniżej pełna lista, różnice między pakietami,
        opieka miesięczna, od czego zależy wycena i sytuacje, w których
        nie proponujemy wdrożenia.
      </p>
      <div class="buttonrow">
        <ContactLink class="btn btn--primary" label="Napisz do nas" />
        <a class="btn btn--ghost" href="#porownanie">Porównaj pakiety</a>
      </div>
      <p class="small muted" style="margin-top:14px">
        Wszystkie kwoty są netto. VAT doliczamy zgodnie z przepisami, faktura z 7-dniowym
        terminem płatności.
      </p>
    </div>
  </section>

  <section class="section" id="cennik">
    <div class="wrap">
      <div class="section-head">
        <h2>Cennik usług</h2>
        <p class="section-intro">
          Wszystkie kwoty są netto. Terminy orientacyjne, liczone od przekazania
          dostępów i danych testowych.
        </p>
      </div>

      <div class="table-wrap price-table" tabindex="0" role="region" aria-label="Cennik usług Studio Automatyzacji">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Usługa</th>
              <th scope="col">Cena netto</th>
              <th scope="col">Co zawiera</th>
              <th scope="col">Termin</th>
            </tr>
          </thead>
          <tbody>
            {prices.map((p) => (
              <tr>
                <td>{p.service}</td>
                <td>{p.price}</td>
                <td>{p.includes}</td>
                <td>{p.term}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="price-cards" role="group" aria-label="Cennik usług Studio Automatyzacji">
        {prices.map((p) => (
          <div class="price-card">
            <h3>{p.service}</h3>
            <p class="price-card-price">{p.price}</p>
            <p>{p.includes}</p>
            <p class="price-card-term">{p.term}</p>
          </div>
        ))}
      </div>
      <p class="table-note">Cennik na wąskim ekranie jest pokazany jako lista.</p>
      <p class="small muted" style="margin-top:14px">
        Audyt {P.audit} odliczamy od pierwszej faktury za wdrożenie. Mini-diagnoza jest
        bezpłatna i nie zobowiązuje do audytu. White-label rozliczamy z agencją,
        nie z klientem końcowym.
      </p>
    </div>
  </section>

  <section class="section" id="czego-nie-obejmuje">
    <div class="wrap">
      <div class="section-head">
        <h2>Czego nie obejmuje cena</h2>
        <p class="section-intro">
          Cztery rzeczy, które zostają po stronie klienta albo wymagają osobnej wyceny
          przed wykonaniem pracy. Nie dokładamy ich do faktury po fakcie.
        </p>
      </div>

      <ul class="plainlist">
        <li>
          <strong>Licencje narzędzi i koszty API</strong> ponosi klient, bo działają na
          jego kontach i zależą od jego wolumenu.
        </li>
        <li>
          <strong>Prace poza zakresem</strong> wyceniamy przed wykonaniem i realizujemy
          dopiero po pisemnej akceptacji.
        </li>
        <li>
          <strong>Migracje danych historycznych</strong> to osobne zlecenie, chyba że
          zakres wdrożenia wprost je obejmuje.
        </li>
        <li>
          <strong>Zmiany procesów po odbiorze</strong> wyceniamy osobno i nie wchodzą
          w cenę wdrożenia ani w limit opieki.
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="porownanie">
    <div class="wrap">
      <div class="section-head">
        <h2>Porównanie pakietów</h2>
        <p class="section-intro">
          Start dla jednego procesu, Growth dla trzech, Scale dla większego środowiska.
          Nie sprzedajemy pakietu, którego zakresu nie da się obronić.
        </p>
      </div>

      <div class="table-wrap compare-table" tabindex="0" role="region" aria-label="Tabela porównawcza pakietów Start, Growth i Scale">
        <table class="table table--compare">
          <thead>
            <tr>
              <th scope="col">Zakres</th>
              <th scope="col">Start</th>
              <th scope="col">Growth</th>
              <th scope="col">Scale</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <td>{row[0]}</td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
                <td>{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="compare-cards" role="group" aria-label="Porównanie pakietów Start, Growth i Scale">
        {['Start', 'Growth', 'Scale'].map((name, index) => (
          <div class="compare-card">
            <h3>{name}</h3>
            <dl>
              {comparison.map((row) => (
                <Fragment>
                  <dt>{row[0]}</dt>
                  <dd class={row[0] === 'Cena netto' ? 'compare-price' : undefined}>{row[index + 1]}</dd>
                </Fragment>
              ))}
            </dl>
          </div>
        ))}
      </div>
      <p class="table-note">Pakiety na wąskim ekranie są pokazane jako karty.</p>

      <div class="section-foot">
        <span class="small muted">Płatność 50% przed startem, 50% po odbiorze. Faktura.</span>
        <a class="text-link" href="/wdrozenia#cennik">Opis pakietów i zakresów</a>
      </div>
    </div>
  </section>

  <section class="section section--paper2" id="opieka">
    <div class="wrap">
      <div class="section-head">
        <h2>Opieka miesięczna</h2>
        <p class="section-intro">
          Plan jest miesięczny, bez rocznego zobowiązania, z miesięcznym
          wypowiedzeniem. Ceny netto.
        </p>
      </div>

      <div class="table-wrap" tabindex="0" role="region" aria-label="Zakres opieki technicznej">
        <table class="table table--compare">
          <thead>
            <tr>
              <th scope="col">Zakres</th>
              <th scope="col">Opieka {P.care}/mc</th>
            </tr>
          </thead>
          <tbody>
            {careRows.map((row) => (
              <tr>
                <td>{row[0]}</td>
                <td>{row[1]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="section-foot">
        <span class="small muted">Ceny netto. Nadwyżka ponad limit godzin wyceniana osobno, przed wykonaniem pracy.</span>
        <a class="text-link" href="/opieka">Pełny opis opieki</a>
      </div>
    </div>
  </section>

  <section class="section" id="sciezka">
    <div class="wrap">
      <div class="section-head">
        <h2>Ścieżka w trzech krokach</h2>
        <p class="section-intro">
          Bezpłatna mini-diagnoza nie jest opłatą wstępną do wdrożenia. Audyt jest
          osobną usługą, którą można zakończyć decyzją „nie wdrażamy”.
        </p>
      </div>

      <div class="path path--3">
        <div class="path-step">
          <span class="n">01</span>
          <h3>Napisz do nas</h3>
          <p class="price">{P.miniDiagnosis}</p>
          <p>Opisujesz proces, narzędzia i liczbę osób. Odpowiadamy w ciągu 1 dnia roboczego.</p>
          <span class="when">Formularz · e-mail</span>
        </div>
        <div class="path-step">
          <span class="n">02</span>
          <h3>Mini-diagnoza</h3>
          <p class="price">{P.miniDiagnosis}</p>
          <p>Krótka pisemna ocena jednego procesu: sens, szacunek godzin [EST], narzędzia.</p>
          <span class="when">Odpowiedź w 2 dni robocze</span>
        </div>
        <div class="path-step">
          <span class="n">03</span>
          <h3>Audyt</h3>
          <p class="price">{P.audit} netto</p>
          <p>Raport z kosztem, priorytetami i wyceną. Odliczany od wdrożenia.</p>
          <span class="when">Orientacyjnie 3 dni robocze</span>
        </div>
      </div>

      <div class="section-foot">
        <span class="small muted">
          Po audycie: wdrożenie {P.start} / {P.growth} / {P.scaleFrom} netto, potem opcjonalna
          opieka {P.care} netto/mc.
        </span>
        <a class="text-link" href="/wdrozenia">Zakres wdrożeń</a>
      </div>

      <div class="condition" style="margin-top:32px">
        <h2>Warunek, który stosujemy przed wdrożeniem</h2>
        <p>
          Jeśli audyt nie wykaże zwrotu w maksymalnie 12 miesiącach, nie proponujemy wdrożenia.
          To decyzja, nie haczyk. Raport zostaje u Ciebie jako dokument z rekomendacjami.
        </p>
        <p class="small" style="margin-bottom:0">
          Audyt jest osobną usługą. Odliczamy go od wdrożenia tylko wtedy, gdy do niego dojdzie.
          Nie obiecujemy zwrotu gotówki.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="od-czego-zalezy">
    <div class="wrap">
      <div class="section-head">
        <h2>Od czego zależy cena</h2>
        <p class="section-intro">
          Nie mamy cennika „za godzinę”. Cena wynika z zakresu, liczby integracji,
          jakości danych i sposobu utrzymania.
        </p>
      </div>

      <div class="problem-grid">
        {costDrivers.map((item, i) => (
          <div class="problem-item">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.t}</h3>
              <p>{item.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="kiedy-sie-nie-oplaca">
    <div class="wrap">
      <div class="section-head">
        <h2>Kiedy automatyzacja się NIE opłaca</h2>
        <p class="section-intro">
          Także wtedy, gdy ktoś chce ją kupić. Lepiej powiedzieć „nie” przed audytem
          niż po wdrożeniu, które nie ma z czego się zwrócić.
        </p>
      </div>

      <div class="problem-grid">
        {notWorth.map((item, i) => (
          <div class="problem-item">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.t}</h3>
              <p>{item.d}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="note" style="margin-top:32px">
        <strong>Uczciwa ocena dopasowania.</strong> Jeśli po mini-diagnozie widać, że
        automatyzacja nie ma sensu, mówimy to od razu. Bezpłatna diagnoza nie jest
        etapem sprzedaży, po którym zawsze następuje oferta.
      </div>
    </div>
  </section>

  <section class="section section--paper2" id="kalkulator">
    <div class="wrap">
      <div class="section-head">
        <h2>Policz oszczędność na swoich założeniach</h2>
        <p class="section-intro">
          Suwaki zmieniają wynik na żywo. To model [EST], nie wynik klienta.
          W audycie liczymy na Twoich danych, nie na przeciętnych.
        </p>
      </div>
      <Calculator id="kalkulator-panel" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Scenariusz modelowy</h2>
        <p class="section-intro">
          Model pokazuje arytmetykę, nie wynik klienta. W audycie liczymy na Twoich danych.
        </p>
      </div>
      <Scenario />
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head">
        <h2>Pytania o koszty i czas</h2>
        <p class="section-intro">
          Ceny, opieka, płatności i zakres. Bez ukrytych warunków.
        </p>
      </div>
      <FAQ items={pricingFaq} />
    </div>
  </section>

  <CTA
    title="Masz proces i chcesz poznać cenę?"
    text="Napisz, co robisz ręcznie i z jakich narzędzi korzystasz. Odpowiemy, czy wystarczy mini-diagnoza, czy potrzebny jest audyt."
  />
</Base>
