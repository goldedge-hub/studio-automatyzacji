---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import { P } from '../../data/pricing';

const faq = [
  {
    q: 'Czy to działa z moim ERP?',
    a: 'Jeśli ERP ma API albo eksport pliku — tak. Najczęściej pracujemy z Subiektem, Comarch i systemami, które wystawiają dokumenty przez API. Jeśli API nie ma, wdrażamy kolejkę z plikiem i kontrolą człowieka; taki zakres wyceniamy osobno.',
  },
  {
    q: 'Co się dzieje z zamówieniem, którego nie da się zmapować?',
    a: 'Nie zgadujemy. Zamówienie trafia do kolejki wyjątków z powodem, a osoba odpowiedzialna dostaje powiadomienie. Reszta idzie dalej. Dzięki temu jeden nietypowy produkt nie zatrzymuje całego dnia.',
  },
  {
    q: 'Czy automatyzacja zastąpi pracownika?',
    a: 'Zwykle zastępuje konkretną czynność, nie osobę. Celem jest to, żeby nikt nie przepisywał numerów zamówień i nie szukał rozjazdów między sklepem a magazynem.',
  },
  {
    q: 'Jak sprawdzacie, że działa?',
    a: 'Na danych testowych: 100 zamówień z różnych kanałów, w tym zwroty, anulowania i produkt z dwoma kodami. Odbiór następuje, gdy w polach krytycznych nie ma rozjazdów, a każdy błąd ma wpis w logu.',
  },
  {
    q: 'Ile to kosztuje?',
    a: `Jeden proces end-to-end, do trzech integracji, mieści się w pakiecie Start (${P.start} netto). Więcej kanałów i systemów to Growth (${P.growth} netto). Dokładny zakres potwierdzamy po diagnozie.`,
  },
];
---

<Base
  title="Zamówienia bez przepisywania — sklep, marketplace i ERP"
  description="Automatyzacja przepływu zamówień: sklep i marketplace do ERP i księgowości, z kolejką wyjątków, logiem i alertem. Zakres, granice i kryteria odbioru."
  path="/oferty/zamowienia-bez-przepisywania/"
  faq={faq}
>
  <section class="page-head">
    <div class="wrap">
      <p class="mono">Oferta / zamówienia</p>
      <h1>Zamówienia bez przepisywania.</h1>
      <p class="lead">
        Sklep, marketplace i ERP przestają żyć własnym życiem. Zamówienie przechodzi z kanału
        do systemu bez przeklejania, a to, czego nie da się zmapować, trafia do kolejki z powodem
        — nie do czyjejś pamięci.
      </p>
      <div class="buttonrow" style="margin-top:24px">
        <a class="btn btn--primary" href="/kontakt/?temat=wdrozenie&amp;context=zamowienia"
           data-umami-event="cta_click" data-umami-event-label="Oferta zamówienia: diagnoza">Zamów bezpłatną diagnozę — 24 h</a>
        <a class="text-link" href="#zakres">Zakres i kryteria odbioru</a>
      </div>
    </div>
  </section>

  <section class="section section--paper2" id="zakres">
    <div class="wrap">
      <div class="section-head">
        <h2>Co dokładnie jest wdrażane</h2>
        <p class="section-intro">Nie „integracja”, tylko sześć konkretnych rzeczy, które muszą działać po kolei.</p>
      </div>
      <table class="table">
        <tbody>
          <tr><td><strong>1. Wejście</strong></td><td>Webhook lub API z kanału: nowe zamówienie, opłata, anulowanie, zwrot</td></tr>
          <tr><td><strong>2. Mapowanie</strong></td><td>Pola zamówienia na pola ERP: kontrahent, pozycje, rabat, dostawa, płatność</td></tr>
          <tr><td><strong>3. Wyjątki</strong></td><td>Kolejka pozycji, których nie da się zmapować, z powodem i właścicielem</td></tr>
          <tr><td><strong>4. Dokument</strong></td><td>Faktura lub zamówienie w ERP, z numeracją i statusem</td></tr>
          <tr><td><strong>5. Log</strong></td><td>Każde zdarzenie z identyfikatorem zamówienia i czasem — do diagnozy bez zgadywania</td></tr>
          <tr><td><strong>6. Alert</strong></td><td>Powiadomienie, gdy przepływ się zatrzyma lub błąd powtórzy się dwa razy</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Czego nie obiecujemy</h2>
      </div>
      <ul class="checklist">
        <li>Nie gwarantujemy, że każdy wyjątek da się zautomatyzować — część zostaje do decyzji człowieka.</li>
        <li>Nie zmieniamy procesu w ERP bez właściciela po stronie klienta.</li>
        <li>Nie przejmujemy odpowiedzialności za dane, których nikt nie kontroluje.</li>
        <li>Nie wdrażamy na produkcji bez testu na danych testowych.</li>
        <li>Nie obiecujemy oszczędności w złotówkach przed policzeniem wolumenu.</li>
      </ul>
    </div>
  </section>

  <section class="section section--paper2">
    <div class="wrap">
      <div class="section-head">
        <h2>Jak wygląda praca</h2>
      </div>
      <div class="path">
        <div class="path-step">
          <span class="n">01</span>
          <h3>Diagnoza</h3>
          <p class="price">Opis i wolumen</p>
          <p>Kanały, system, liczba zamówień, wyjątki. Na tej podstawie mówimy, czy ma to sens.</p>
          <span class="when">24 h</span>
        </div>
        <div class="path-step">
          <span class="n">02</span>
          <h3>Testy</h3>
          <p class="price">100 zamówień</p>
          <p>Różne kanały, zwroty, anulowania, produkt z dwoma kodami. Na danych testowych.</p>
          <span class="when">3–6 dni</span>
        </div>
        <div class="path-step">
          <span class="n">03</span>
          <h3>Wdrożenie</h3>
          <p class="price">Produkcja z logiem</p>
          <p>Uruchomienie z monitoringiem od pierwszej minuty, nie „po tygodniu”.</p>
          <span class="when">1–2 dni</span>
        </div>
        <div class="path-step">
          <span class="n">04</span>
          <h3>Odbiór</h3>
          <p class="price">Kryteria na piśmie</p>
          <p>Zero rozjazdów w polach krytycznych, każdy błąd w logu, runbook przekazany.</p>
          <span class="when">Po testach</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Cena i warunki</h2>
      </div>
      <table class="table">
        <tbody>
          <tr><td><strong>Zakres</strong></td><td>1 proces, do 3 integracji, kolejka wyjątków, log, alert</td></tr>
          <tr><td><strong>Cena</strong></td><td>{P.start} netto (Start). Więcej kanałów lub systemów — {P.growth} netto (Growth).</td></tr>
          <tr><td><strong>Wymagania</strong></td><td>Dostęp testowy do systemów, osoba odpowiedzialna za akceptację, dane testowe</td></tr>
          <tr><td><strong>Termin</strong></td><td>5–10 dni roboczych od dostępów</td></tr>
          <tr><td><strong>Gwarancja</strong></td><td>30 dni po odbiorze, potem opieka techniczna lub przekazanie runbooka</td></tr>
        </tbody>
      </table>
      <p style="margin-top:18px"><a class="text-link" href="/ile-kosztuje/">Pełny cennik</a></p>
    </div>
  </section>

  <section class="section section--paper2">
    <div class="wrap">
      <div class="section-head"><h2>Pytania</h2></div>
      <FAQ items={faq} />
    </div>
  </section>

  <CTA
    title="Policzmy, ile godzin zjada u Ciebie przepisywanie zamówień."
    text="Napisz, ile zamówień dziennie obsługujesz i między jakimi systemami. W ciągu 24 godzin dostaniesz odpowiedź, czy automatyzacja się zwraca."
  />
</Base>
