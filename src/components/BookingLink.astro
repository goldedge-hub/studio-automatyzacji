---
import { BOOKING_HREF, BOOKING_URL } from '../config';

const {
  class: className = 'btn btn--primary',
  label = 'Umów rozmowę 20 min',
} = Astro.props;
---
<a
  class={className}
  href={BOOKING_HREF}
  target={BOOKING_URL ? '_blank' : undefined}
  rel={BOOKING_URL ? 'noopener noreferrer' : undefined}
>{label}</a>
