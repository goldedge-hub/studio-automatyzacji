---
const {
  title = 'Sprawdź, czy ten proces warto automatyzować.',
  text = 'Opisz jeden proces, narzędzia i wolumen. Odpowiemy e-mailem, czy wystarczy gotowa integracja, czy potrzebna jest osobna praca. Bez zobowiązania.',
} = Astro.props;
---
<section class="section section--dark">
  <div class="wrap">
    <div class="cta-grid">
      <div>
        <p class="mono" style="color:var(--on-dark-muted)">Następny krok</p>
        <h2>{title}</h2>
        <p class="cta-copy">{text}</p>
      </div>
      <div class="cta-actions">
        <div class="buttonrow">
          <a class="btn btn--accent" href="/kontakt/?temat=mini-diagnoza">Mini-diagnoza 0 zł</a>
          <a class="btn btn--on-dark" href="/ile-kosztuje/">Ceny netto</a>
        </div>
        <p class="small">
          Mini-diagnoza jest bezpłatna i przychodzi e-mailem w ciągu 2 dni roboczych.
          Nie jest etapem sprzedażowym, po którym zawsze następuje oferta.
        </p>
      </div>
    </div>
  </div>
</section>
