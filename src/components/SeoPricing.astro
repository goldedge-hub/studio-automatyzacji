---
import { P, PACKAGES, PRICE_UPDATED } from '../data/pricing';

const {
  heading = 'Ile to kosztuje',
  intro = 'Cena jest stała dla zakresu opisanego przed startem. Ceny netto.',
  fit = null,
  note = null,
} = Astro.props;
---
<section class="section section--paper2" id="cennik">
  <div class="wrap">
    <div class="section-head">
      <h2>{heading}</h2>
      <p class="section-intro">{intro}</p>
    </div>

    {fit && <p class="lead" style="margin-bottom:28px">{fit}</p>}

    <div class="plans">
      <div class="plan">
        <div class="plan-head">
          <h3>Start</h3>
          <span class="scope">{PACKAGES.start.processes}</span>
        </div>
        <p class="price">{P.start} <small>netto</small></p>
        <ul>
          <li>{PACKAGES.start.integrations}</li>
          <li>{PACKAGES.start.warranty}</li>
          <li>{PACKAGES.start.time}</li>
        </ul>
        <a class="btn btn--ghost" href="/kontakt?temat=mini-diagnoza">Zapytaj o Start</a>
      </div>

      <div class="plan">
        <div class="plan-head">
          <h3>Growth</h3>
          <span class="scope">{PACKAGES.growth.processes}</span>
        </div>
        <p class="price">{P.growth} <small>netto</small></p>
        <ul>
          <li>{PACKAGES.growth.integrations}</li>
          <li>{PACKAGES.growth.warranty}</li>
          <li>{PACKAGES.growth.time}</li>
        </ul>
        <a class="btn btn--ghost" href="/kontakt?temat=mini-diagnoza">Zapytaj o Growth</a>
      </div>

      <div class="plan">
        <div class="plan-head">
          <h3>Scale</h3>
          <span class="scope">{PACKAGES.scale.processes}</span>
        </div>
        <p class="price">{P.scaleFrom} <small>netto</small></p>
        <ul>
          <li>integracje ERP / WMS</li>
          <li>wdrożenie etapami</li>
          <li>SLA w umowie</li>
        </ul>
        <a class="btn btn--ghost" href="/kontakt?temat=mini-diagnoza">Zapytaj o Scale</a>
      </div>
    </div>

    <div class="section-foot">
      <span class="small muted">
        Audyt {P.audit} netto odliczamy od wdrożenia. Opieka {P.careMc} netto.
        Aktualizacja {PRICE_UPDATED}.
      </span>
      <a class="text-link" href="/ile-kosztuje#porownanie">Pełny cennik</a>
    </div>

    {note && <p class="small muted" style="margin-top:14px">{note}</p>}
  </div>
</section>
