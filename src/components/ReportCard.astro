---
// Karta artefaktu: fragment przykładowego raportu operacyjnego.
// Używana w hero strony głównej i na /audyt/. Dane oznaczone jako przykładowe,
// bo raport publiczny jest przykładem, nie wynikiem klienta.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['rep', compact && 'rep--compact']} role="group" aria-label="Fragment przykładowego raportu operacyjnego">
  <div class="rep-top">
    <span>Raport operacyjny</span>
    <span>SA/RAP/2026/11</span>
  </div>

  <h2 class="rep-title">Czas pracy w obsłudze zamówień</h2>
  <p class="rep-sub">Sklep z 640 zamówieniami miesięcznie · 3 kanały sprzedaży</p>

  <div class="rep-chart">
    <p class="rep-label">Godziny pracy miesięcznie</p>
    <svg viewBox="0 0 360 132" role="img" aria-label="Wykres: 41 godzin pracy ręcznej miesięcznie, 9 godzin po wdrożeniu">
      <line x1="0" y1="104" x2="360" y2="104" stroke="rgba(8,45,79,.18)"></line>
      <rect x="0" y="26" width="150" height="78" fill="#082d4f"></rect>
      <rect x="180" y="87" width="150" height="17" fill="#1f2ad8"></rect>
      <text x="0" y="18" font-family="Plex Mono, monospace" font-size="13" fill="#16405f">41 h</text>
      <text x="180" y="79" font-family="Plex Mono, monospace" font-size="13" fill="#1f2ad8">9 h</text>
      <text x="0" y="124" font-family="Plex Mono, monospace" font-size="11" fill="#4f6679">PRZED</text>
      <text x="180" y="124" font-family="Plex Mono, monospace" font-size="11" fill="#4f6679">PO WDROŻENIU</text>
    </svg>
    <div class="rep-legend">
      <span><i style="background:#082d4f"></i>ręczna praca</span>
      <span><i style="background:#1f2ad8"></i>czas po automatyzacji</span>
    </div>
  </div>

  <div class="rep-rows">
    <div class="rep-row"><span>Przepisywanie zamówień między kanałami</span><b>17 h / mies.</b></div>
    <div class="rep-row"><span>Ręczne generowanie dokumentów wysyłkowych</span><b>11 h / mies.</b></div>
    <div class="rep-row"><span>Reakcje na błędy stanów i cen</span><b>8 h / mies.</b></div>
    <div class="rep-row"><span>Szacowany koszt pracy rocznie</span><b class="hot">34 200 zł</b></div>
  </div>
</div>
<p class="rep-cap">
  <span><b>Fig. 01</b> — fragment przykładowego raportu</span>
  <a href="/przykladowy-raport/">Zobacz cały dokument →</a>
</p>
