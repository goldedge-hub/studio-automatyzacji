---
import { CONTACT_HREF } from '../config';

const {
  title = 'Zacznij od jednej wiadomości.',
  text = 'Opisz proces, który zabiera czas. Odpowiemy w ciągu jednego dnia roboczego i powiemy, czy wystarczy bezpłatna mini-diagnoza, czy potrzebny jest płatny audyt.',
} = Astro.props;
---
<section class="section section--dark">
  <div class="wrap">
    <div class="cta-grid">
      <div>
        <p class="mono" style="color:var(--on-dark-muted)">Następny krok</p>
        <h2>{title}</h2>
        <p class="cta-copy">{text}</p>
      </div>
      <div class="cta-actions">
        <div class="buttonrow">
          <a class="btn btn--accent" href={CONTACT_HREF}>Napisz do nas</a>
          <a class="btn btn--on-dark" href="/audyt#mini-diagnoza">Mini-diagnoza 0 zł</a>
        </div>
        <p class="small">
          Mini-diagnoza jest bezpłatna i przychodzi e-mailem w 2 dni robocze.
          Audyt 890 zł netto odliczamy od wdrożenia.
        </p>
      </div>
    </div>
  </div>
</section>
