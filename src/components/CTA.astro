---
import BookingLink from './BookingLink.astro';

const {
  title = 'Zacznij od 20 minut.',
  text = 'Opowiedz o procesie, który najbardziej zjada czas. Po rozmowie wiesz, czy warto robić audyt i ile to będzie kosztować.',
} = Astro.props;
---
<section class="section section--dark">
  <div class="wrap">
    <div class="cta-grid">
      <div>
        <p class="mono" style="color:var(--on-dark-muted)">Następny krok</p>
        <h2>{title}</h2>
        <p class="cta-copy">{text}</p>
      </div>
      <div class="cta-actions">
        <div class="buttonrow">
          <BookingLink class="btn btn--accent" />
          <a class="btn btn--on-dark" href="/audyt">Audyt 890 zł</a>
        </div>
        <p class="small">
          Bezpłatna rozmowa trwa 20 minut. Audyt jest osobną usługą, odliczaną od wdrożenia.
        </p>
      </div>
    </div>
  </div>
</section>
