---
import { CONTACT_HREF } from '../config';
import { P } from '../data/pricing';

const {
  title = 'Zacznij od jednej wiadomości.',
  text = 'Opisz proces, który zabiera czas. Odpowiemy w ciągu 24 godzin i powiemy, czy wystarczy bezpłatna diagnoza i wycena, czy potrzebny jest płatny audyt.',
} = Astro.props;
---
<section class="section section--dark">
  <div class="wrap">
    <div class="cta-grid">
      <div>
        <p class="mono" style="color:var(--on-dark-muted)">Następny krok</p>
        <h2>{title}</h2>
        <p class="cta-copy">{text}</p>
      </div>
      <div class="cta-actions">
        <div class="buttonrow">
          <a
            class="btn btn--accent"
            href={CONTACT_HREF}
            data-umami-event="cta_click"
            data-umami-event-label="CTA: napisz do nas"
          >Napisz do nas</a>
          <a
            class="btn btn--on-dark"
            href="/audyt/#diagnoza"
            data-umami-event="cta_click"
            data-umami-event-label="CTA: diagnoza i wycena 0 zł"
          >Diagnoza i wycena {P.miniDiagnosis}</a>
        </div>
        <p class="small">
          Diagnoza i wycena jest bezpłatna i przychodzi e-mailem w ciągu 24 godzin.
          Audyt {P.audit} netto odliczamy od wdrożenia.
        </p>
      </div>
    </div>
  </div>
</section>
