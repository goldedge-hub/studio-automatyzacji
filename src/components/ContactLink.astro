---
const {
  class: className = 'btn btn--primary',
  label = 'Napisz do nas',
  href = '/kontakt',
  topic,
  eventLabel = label,
} = Astro.props;

const target = topic ? `${href}?temat=${encodeURIComponent(topic)}` : href;
---
<a
  class={className}
  href={target}
  data-umami-event="cta_click"
  data-umami-event-label={eventLabel}
>{label}</a>
