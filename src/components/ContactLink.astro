---
import { CONTACT_HREF, withTrailingSlash } from '../config';

const {
  class: className = 'btn btn--primary',
  label = 'Napisz do nas',
  href = CONTACT_HREF,
  topic,
  plan,
  eventLabel = label,
} = Astro.props;

const params = new URLSearchParams();
if (topic) params.set('temat', topic);
if (plan) params.set('plan', plan);
const base = withTrailingSlash(href);
const target = params.size ? `${base}?${params.toString()}` : base;
---
<a
  class={className}
  href={target}
  data-umami-event="cta_click"
  data-umami-event-label={eventLabel}
>{label}</a>
