# Adres kontaktowy używany w mailto, JSON-LD, stopce i dokumentach.
# Domyślnie: tomasz.dziedzicki@gmail.com (skrzynka kontakt@studioautomatyzacji.pl nie istnieje).
PUBLIC_CONTACT_EMAIL=tomasz.dziedzicki@gmail.com

# Opcjonalny endpoint formularza (np. https://formspree.io/f/xxxxxxx).
# Jeśli pusty, formularz działa wyłącznie jako mailto.
PUBLIC_FORM_ENDPOINT=

# Opcjonalny link rezerwacji rozmowy (np. Calendly).
# Jeśli pusty, CTA prowadzi do /kontakt?temat=rozmowa.
PUBLIC_BOOKING_URL=
