# Adres kontaktowy używany w mailto, JSON-LD, stopce i dokumentach.
# Domyślnie: kontakt@studioautomatyzacji.pl (skrzynka zakładana przez Hermesa).
PUBLIC_CONTACT_EMAIL=kontakt@studioautomatyzacji.pl

# Opcjonalny endpoint formularza (np. https://formspree.io/f/xxxxxxx).
# Jeśli pusty, formularz działa jako mailto na PUBLIC_CONTACT_EMAIL.
PUBLIC_FORM_ENDPOINT=
